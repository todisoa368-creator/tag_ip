<!DOCTYPE html>
<html lang="fr" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="TagIp" suffix=" · TAG-Monitor">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}></script>
    <style>
  
      input, textarea, select {
        background-color: white !important;
        color: #111827 !important; /* Gris très foncé presque noir */
        border: 1px solid #D1D5DB !important;
      }
      input::placeholder, textarea::placeholder {
        color: #6B7280 !important; /* Gris clair pour le placeholder */
      }
    </style>
  </head>
  <body class="flex flex-col min-h-screen bg-gray-50 text-gray-900">

    <% current_path = assigns[:current_path] || "" %>

    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center gap-10">
            <.link navigate={~p"/"} class="text-2xl font-black text-blue-600 tracking-tighter">
              TAG-IP
            </.link>
        <nav class="hidden sm:flex sm:space-x-8 h-full">
            <.link
              navigate={~p"/"}
              class={[
                "inline-flex items-center px-1 pt-1 border-b-2 text-sm font-semibold transition-all duration-200",
                current_path == "/" && "border-blue-600 text-blue-600",
                current_path != "/" && "border-transparent text-gray-500 hover:text-blue-600 hover:border-blue-600"
              ]}
            >
              Dashboard
            </.link>
            <.link
              navigate={~p"/profils"}
              class={[
                "inline-flex items-center px-1 pt-1 border-b-2 text-sm font-semibold transition-all duration-200",
                String.starts_with?(current_path, "/profils") && "border-blue-600 text-blue-600",
                !String.starts_with?(current_path, "/profils") && "border-transparent text-gray-500 hover:text-blue-600 hover:border-blue-600"
              ]}
            >
              Profils de montage
            </.link>

         <.link
              navigate={~p"/modeles"}
              class={[
                "inline-flex items-center px-1 pt-1 border-b-2 text-sm font-semibold transition-all duration-200",
                String.starts_with?(current_path, "/modeles") && "border-blue-600 text-blue-600",
                !String.starts_with?(current_path, "/modeles") && "border-transparent text-gray-500 hover:text-blue-600 hover:border-blue-600"
              ]}
            
            > 
          Modeles de traceurs 
            </.link>


            <.link
              navigate={~p"/compatibilites"}
              class={[
                "inline-flex items-center px-1 pt-1 border-b-2 text-sm font-semibold transition-all duration-200",
                String.starts_with?(current_path, "/compatibilites") && "border-blue-600 text-blue-600",
                !String.starts_with?(current_path, "/compatibilites") && "border-transparent text-gray-500 hover:text-blue-600 hover:border-blue-600"
              ]}
            >
              Compatibilités
            </.link>
          </nav>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <.flash_group flash={assigns[:flash] || %{}} />
        {@inner_content}
      </div>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6">
      <div class="max-w-7xl mx-auto px-4 text-center text-sm text-gray-500">
        <p>TAG-IP Monitor © 2026 — Internship Project — Management of mounting profiles</p>
      </div>
    </footer>
  </body>
</html>