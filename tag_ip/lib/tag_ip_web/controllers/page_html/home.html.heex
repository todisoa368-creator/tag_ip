<div class="relative min-h-screen overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-white to-indigo-50" />

  <div class="relative px-4 py-16 sm:px-6 sm:py-28 lg:px-8 xl:px-28 xl:py-32">
    <div class="mx-auto max-w-xl lg:mx-0">
      <img src={~p"/images/logo.svg"} alt="TAG-IP" class="h-16 w-auto" />

      <div class="mt-10 flex items-center gap-4">
        <h1 class="flex items-center text-sm font-semibold leading-6 text-zinc-700">
          TAG-IP
          <span class="ml-3 rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-700">
            Créateur de solutions connectées
          </span>
        </h1>
      </div>

      <p class="text-4xl mt-6 font-bold leading-tight tracking-tight text-gray-900">
        Géolocalisation · IoT · Collecte de données
      </p>
      <p class="mt-4 text-lg leading-relaxed text-gray-500 max-w-lg">
        TAG-IP est le leader des solutions de tracking et de géolocalisation à Madagascar.
        Suivez votre flotte en temps réel, améliorez la productivité et réduisez les coûts d'exploitation.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <a
          href="https://www.tag-ip.com/track-decouverte/"
          target="_blank"
          class="group relative overflow-hidden rounded-xl bg-white px-6 py-5 shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition-all duration-200"
        >
          <span class="relative flex items-center gap-4 sm:flex-col sm:text-center">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class="h-8 w-8 text-blue-600 shrink-0"
            >
              <path
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                fill="currentColor"
                fill-opacity=".15"
                stroke="currentColor"
                stroke-width="2"
              />
              <circle
                cx="12"
                cy="9"
                r="2.5"
                fill="currentColor"
                fill-opacity=".2"
                stroke="currentColor"
                stroke-width="2"
              />
            </svg>
            <span class="font-semibold text-sm text-gray-900">Track — Géolocalisation</span>
          </span>
        </a>
        <a
          href="https://www.tag-ip.com/smart/"
          target="_blank"
          class="group relative overflow-hidden rounded-xl bg-white px-6 py-5 shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition-all duration-200"
        >
          <span class="relative flex items-center gap-4 sm:flex-col sm:text-center">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class="h-8 w-8 text-blue-600 shrink-0"
            >
              <path
                d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <circle
                cx="9"
                cy="7"
                r="4"
                fill="currentColor"
                fill-opacity=".15"
                stroke="currentColor"
                stroke-width="2"
              />
              <path
                d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
            <span class="font-semibold text-sm text-gray-900">Smart Track — Particuliers</span>
          </span>
        </a>
        <a
          href="https://www.tag-ip.com/forms-decouverte/"
          target="_blank"
          class="group relative overflow-hidden rounded-xl bg-white px-6 py-5 shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition-all duration-200"
        >
          <span class="relative flex items-center gap-4 sm:flex-col sm:text-center">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class="h-8 w-8 text-blue-600 shrink-0"
            >
              <path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                fill="currentColor"
                fill-opacity=".15"
                stroke="currentColor"
                stroke-width="2"
              />
              <polyline
                points="14 2 14 8 20 8"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <line
                x1="16"
                y1="13"
                x2="8"
                y2="13"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <line
                x1="16"
                y1="17"
                x2="8"
                y2="17"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
            <span class="font-semibold text-sm text-gray-900">Forms — Collecte de données</span>
          </span>
        </a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-4 text-sm leading-6 text-gray-500 sm:grid-cols-2">
        <a
          href="https://www.tag-ip.com"
          target="_blank"
          class="group inline-flex items-center gap-3 rounded-lg px-3 py-2 hover:bg-gray-100 transition-colors"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="h-5 w-5 text-gray-400 group-hover:text-gray-600"
          >
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"
              fill="currentColor"
              fill-opacity=".15"
            />
            <path
              d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              stroke="currentColor"
              stroke-width="2"
              fill="none"
            />
          </svg>
          Site web : tag-ip.com
        </a>
        <a
          href="mailto:contact@tag-ip.com"
          class="group inline-flex items-center gap-3 rounded-lg px-3 py-2 hover:bg-gray-100 transition-colors"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="h-5 w-5 text-gray-400 group-hover:text-gray-600"
          >
            <path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              fill="currentColor"
              fill-opacity=".15"
            />
            <polyline
              points="22,6 12,13 2,6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          Contact : contact@tag-ip.com
        </a>
        <a
          href="tel:+261340722305"
          class="group inline-flex items-center gap-3 rounded-lg px-3 py-2 hover:bg-gray-100 transition-colors"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="h-5 w-5 text-gray-400 group-hover:text-gray-600"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              stroke="currentColor"
              stroke-width="2"
              fill="none"
            />
          </svg>
          (+261) 34 07 223 05
        </a>
        <a
          href="https://www.tag-ip.com"
          target="_blank"
          class="group inline-flex items-center gap-3 rounded-lg px-3 py-2 hover:bg-gray-100 transition-colors"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="h-5 w-5 text-gray-400 group-hover:text-gray-600"
          >
            <path
              d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
            />
          </svg>
          Projet Open Source — TAG-Monitor
        </a>
      </div>

      <div class="mt-16 pt-8 border-t border-gray-200">
        <.link
          navigate={~p"/users/log-in"}
          class="inline-flex items-center gap-3 px-8 py-4 bg-blue-600 text-white font-semibold rounded-xl shadow-lg hover:bg-blue-700 hover:shadow-xl transition-all duration-200"
        >
          Accéder à l'interface de gestion
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </.link>
      </div>
    </div>
  </div>
</div>
