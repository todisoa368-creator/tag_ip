<div class="min-h-screen bg-gray-50 py-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
   
    <div class="md:flex md:items-center md:justify-between mb-10">
      <div class="min-w-0 flex-1">
        <h2 class="text-3xl font-extrabold leading-7 text-gray-900 sm:truncate">
          Gestion des profils
        </h2>
        <p class="mt-2 text-sm text-gray-500">
          Consultez et gérez les configurations de montage pour vos traceurs GPS.
        </p>
      </div>
      <div class="mt-4 flex md:ml-4 md:mt-0">
        <.link
          navigate={~p"/profils/new"}
          class="inline-flex items-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-blue-700 transition-all"
        >
          <svg class="-ml-1 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
          Nouveau profil
        </.link>
      </div>
    </div>

    
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-8">
      <div class="p-12 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-50 mb-4">
          <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900">Aucun profil de montage</h3>
        <p class="mt-2 text-sm text-gray-500">Commencez par créer un profil technique pour tester vos compatibilités.</p>
        <div class="mt-6">
          <.link navigate={~p"/profils/new"} class="text-blue-600 font-semibold hover:text-blue-800 underline">
            Créer le premier profil →
          </.link>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
      <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4">
        <h3 class="text-lg font-bold text-white flex items-center">
          <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          Calcul rapide de compatibilité
        </h3>
      </div>
      
      <form phx-submit="calculer" class="p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Profil de montage</label>
            <select name="profil_id" class="block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 h-11">
              <option>Sélectionner un profil...</option>
    
            </select>
          </div>
          
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Modèle de traceur</label>
            <select name="modele_id" class="block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 h-11">
              <option>Sélectionner un modèle...</option>
    
            </select>
          </div>
        </div>

        <div class="mt-8">
          <button type="submit" class="w-full md:w-auto inline-flex justify-center items-center px-8 py-3 border border-transparent text-base font-bold rounded-xl text-white bg-green-600 hover:bg-green-700 shadow-lg transition-all transform hover:-translate-y-0.5">
            Lancer le calcul
          </button>
        </div>
      </form>
    </div>

  </div>
</div>