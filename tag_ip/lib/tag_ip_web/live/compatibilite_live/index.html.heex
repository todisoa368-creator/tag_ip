<TagIpWeb.Layouts.app flash={@flash}>
  <div class="min-h-screen bg-gray-50 py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="md:flex md:items-center md:justify-between mb-10">
        <div class="min-w-0 flex-1">
          <h2 class="text-3xl font-extrabold leading-7 text-gray-900 sm:truncate">
            Compatibilités
          </h2>
          <p class="mt-2 text-sm text-gray-500">
            Calculez et consultez les compatibilités entre profils de montage et modèles de traceurs.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden mb-8">
        <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4">
          <h3 class="text-lg font-bold text-white flex items-center">
            <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
              />
            </svg>
            Calcul rapide de compatibilité
          </h3>
        </div>

        <form phx-submit="calculer" class="p-8">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">
                Profil de montage
              </label>
              <select
                name="profil_id"
                class="block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 h-11"
              >
                <option value="">Sélectionner un profil...</option>
                <option :for={profil <- @profils} value={profil.id}>{profil.name}</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">
                Modèle de traceur
              </label>
              <select
                name="modele_id"
                class="block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 h-11"
              >
                <option value="">Sélectionner un modèle...</option>
                <option :for={modele <- @modeles} value={modele.id}>{modele.nom}</option>
              </select>
            </div>
          </div>

          <div class="mt-8">
            <button
              type="submit"
              class="w-full md:w-auto inline-flex justify-center items-center px-8 py-3 border border-transparent text-base font-bold rounded-xl text-white bg-green-600 hover:bg-green-700 shadow-lg transition-all transform hover:-translate-y-0.5"
            >
              Lancer le calcul
            </button>
          </div>
        </form>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
          <h3 class="text-lg font-bold text-gray-900">Historique des compatibilités</h3>
          <.search_input
            value={@search}
            placeholder="Rechercher..."
            class="flex-1 max-w-xs ml-4"
            input_class="w-full md:w-full"
          />
        </div>

        <%= if Enum.empty?(@compatibilites) do %>
          <div class="p-12 text-center">
            <p class="text-gray-500">Aucune compatibilité calculée pour le moment.</p>
          </div>
        <% else %>
          <div class="divide-y divide-gray-100">
            <div
              :for={compat <- @compatibilites}
              id={"compat-#{compat.id}"}
              class="px-6 py-4 flex items-center justify-between hover:bg-gray-50"
            >
              <div class="flex-1">
                <p class="text-sm font-medium text-gray-900">
                  {compat.profil_montage.name} ↔ {compat.modele_traceur.nom}
                </p>
                <p class="text-sm text-gray-500">{compat.details}</p>
              </div>
              <div class="ml-4 flex items-center gap-3">
                <span class={[
                  "px-2 py-1 text-xs font-medium rounded-full",
                  compat.score_compatibilite >= 70 && "bg-green-100 text-green-800",
                  compat.score_compatibilite >= 40 && compat.score_compatibilite < 70 &&
                    "bg-yellow-100 text-yellow-800",
                  compat.score_compatibilite < 40 && "bg-red-100 text-red-800"
                ]}>
                  {compat.score_compatibilite}%
                </span>
                <button
                  phx-click="delete"
                  phx-value-id={compat.id}
                  phx-confirm="Supprimer ?"
                  class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg border border-red-300 text-red-700 hover:bg-red-50 transition-colors"
                >
                  Supprimer
                </button>
              </div>
            </div>
          </div>

          <.pagination
            page={@page}
            page_size={@page_size}
            total_count={@total_count}
          />
        <% end %>
      </div>
    </div>
  </div>
</TagIpWeb.Layouts.app>
