<TagIpWeb.Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-3xl mx-auto">
    <div class="mb-8">
      <.header>
        Détails de la compatibilité
        <:subtitle>Analyse technique entre le profil de montage et le traceur GPS.</:subtitle>
      </.header>
    </div>

    <div>
      <div class="shadow-sm rounded-xl bg-white p-6 border border-gray-100">
        <%!-- Score avec couleur dynamique --%>
        <div class="mb-6">
          <span class={[
            "inline-flex items-center px-4 py-1.5 text-lg font-bold rounded-full border",
            @compatibilite.score_compatibilite >= 70 &&
              "bg-green-100 text-green-800 border-green-200",
            @compatibilite.score_compatibilite >= 40 && @compatibilite.score_compatibilite < 70 &&
              "bg-yellow-100 text-yellow-800 border-yellow-200",
            @compatibilite.score_compatibilite < 40 && "bg-red-100 text-red-800 border-red-200"
          ]}>
            Score : {@compatibilite.score_compatibilite}%
          </span>
        </div>

        <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500 uppercase tracking-wider">
              Profil de montage
            </dt>
            <dd class="mt-1 text-md text-gray-900 font-semibold">
              {@compatibilite.profil_montage.name}
            </dd>
          </div>

          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500 uppercase tracking-wider">
              Modèle de traceur
            </dt>
            <dd class="mt-1 text-md text-gray-900 font-semibold">
              {@compatibilite.modele_traceur.nom}
            </dd>
          </div>

          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500 uppercase tracking-wider">
              Analyse détaillée
            </dt>
            <dd class="mt-1 text-sm text-gray-700 bg-gray-50 p-4 rounded-lg border border-gray-100 leading-relaxed whitespace-pre-wrap font-mono text-xs">
              {@compatibilite.details}
            </dd>
          </div>

          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500 uppercase tracking-wider">
              Date du calcul
            </dt>
            <dd class="mt-1 text-sm text-gray-600">
              {format_datetime(@compatibilite.inserted_at)}
            </dd>
          </div>
        </dl>

        <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between gap-4">
          <.link
            navigate={~p"/compatibilites"}
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-sm font-semibold rounded-xl border-2 border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-gray-400 shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
          >
            <.icon name="hero-arrow-left" class="size-4" /> Retour
          </.link>

          <div class="flex items-center gap-2">
            <.link
              navigate={~p"/profils/#{@compatibilite.profil_montage_id}"}
              class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-xl border border-blue-300 text-blue-700 hover:bg-blue-50 transition-all duration-200"
            >
              <.icon name="hero-document-text" class="size-4" /> Voir le profil
            </.link>
            <.link
              navigate={~p"/modeles/#{@compatibilite.modele_traceur_id}"}
              class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-xl border border-indigo-300 text-indigo-700 hover:bg-indigo-50 transition-all duration-200"
            >
              <.icon name="hero-cpu-chip" class="size-4" /> Voir le modèle
            </.link>
            <button
              phx-click="confirm_delete"
              phx-value-id={@compatibilite.id}
              class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-xl border border-red-300 text-red-700 hover:bg-red-50 transition-all duration-200"
            >
              <.icon name="hero-trash" class="size-4" /> Supprimer
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <.confirm_modal show={@pending_delete_id != nil}>
    Êtes-vous sûr de vouloir supprimer la compatibilité <strong>{@pending_delete_label}</strong>
    ? Cette action est irréversible.
  </.confirm_modal>
</TagIpWeb.Layouts.app>
