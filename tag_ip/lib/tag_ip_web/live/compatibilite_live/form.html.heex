<div class="max-w-3xl mx-auto my-10 p-8 bg-white border border-gray-200 shadow-sm rounded-2xl">
  <%!-- En-tête : Titre simple sans indicateurs --%>
  <div class="mb-8 pb-4 border-b border-gray-100">
    <h1 class="text-2xl font-bold text-gray-900">{@page_title}</h1>
  </div>

  <.form for={@form} phx-change="validate" phx-submit="save" class="space-y-8">
    
    <%!-- ÉTAPE 1 : IDENTIFICATION --%>
    <div :if={@step == 1} class="animate-in fade-in duration-300">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Identification du profil</h2>
      <div class="grid gap-6">
        <.input 
          field={@form[:name]} 
          label="Nom du profil" 
          placeholder="ex: Camion 24V Jointech" 
          required 
        />
        <.input 
          field={@form[:description]} 
          type="textarea" 
          label="Description (optionnel)" 
          placeholder="Détails sur l'installation physique..."
        />
      </div>
    </div>

    <%!-- ÉTAPE 2 : CONFIGURATION TECHNIQUE --%>
    <div :if={@step == 2} class="animate-in fade-in duration-300">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Type d'asset et Fréquence</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <.input 
          field={@form[:object_type]} 
          type="select" 
          label="Type d'objet"
          options={[
            {"Véhicule léger", :light_vehicle},
            {"Poids lourd", :truck},
            {"Moto", :motorcycle},
            {"Bateau", :boat},
            {"Asset fixe", :asset}
          ]} 
        />
        <.input 
          field={@form[:reporting_interval]} 
          type="select" 
          label="Intervalle de rapport"
          options={[
            {"10 secondes", :interval_10s},
            {"30 secondes", :interval_30s},
            {"1 minute", :interval_1m},
            {"5 minutes", :interval_5m}
          ]} 
        />
      </div>
    </div>

    <%!-- ÉTAPE 3 : TENSION --%>
    <div :if={@step == 3} class="animate-in fade-in duration-300">
      <h2 class="text-lg font-semibold text-gray-800 mb-2">Seuils de tension (mV)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
        <.input field={@form[:voltage_min]} type="number" label="Tension Minimum" />
        <.input field={@form[:voltage_max]} type="number" label="Tension Maximum" />
      </div>
    </div>

    <%!-- ÉTAPE 4 : OPTIONS FINALES --%>
    <div :if={@step == 4} class="animate-in fade-in duration-300">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Options et Capteurs</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <.input 
          field={@form[:fuel_probe_type]} 
          type="select" 
          label="Sonde de carburant"
          options={[{"Aucune", :none}, {"Analogique", :analog}, {"CAN Bus", :can_bus}, {"RS232", :rs232}]} 
        />
        <.input 
          field={@form[:driver_id_type]} 
          type="select" 
          label="ID Chauffeur"
          options={[{"Aucune", :none}, {"RFID", :rfid}, {"NFC", :nfc}, {"iButton", :ibutton}]} 
        />
      </div>
      <div class="p-4 bg-gray-50 rounded-lg space-y-3">
        <.input field={@form[:buzzer]} type="checkbox" label="Activer le Buzzer" />
        <.input field={@form[:geofence_enabled]} type="checkbox" label="Activer le Geofencing" />
      </div>
    </div>

    <%!-- ACTIONS DE NAVIGATION --%>
    <div class="flex items-center justify-end gap-4 pt-8 border-t border-gray-100 mt-10">
      <button 
        :if={@step > 1} 
        type="button" 
        phx-click="prev-step" 
        class="px-5 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50"
      >
        Précédent
      </button>

        <.link 
          :if={@step == 1}
          navigate={~p"/compatibilites"} 
          class="px-5 py-2 text-sm text-gray-500 hover:text-gray-700"
        >
          Annuler
        </.link>
      
      <button 
        :if={@step < @total_steps} 
        type="button" 
        phx-click="next-step" 
        class="px-6 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-all shadow-sm"
      >
        Suivant
      </button>

      <button 
        :if={@step == @total_steps} 
        type="submit" 
        class="px-6 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition-all shadow-sm"
      >
        Enregistrer le profil
      </button>
    </div>
  </.form>
</div>