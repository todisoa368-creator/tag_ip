<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Profils de Montage</h1>
  <.link 
    patch={~p"/profils/new"} 
    class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-bold"
  >
    Nouveau Profil
  </.link>
</div>

<%= if Enum.empty?(@profils) do %>
  <%!-- Ce bloc s'affiche si vous avez 0 profils --%>
  <div class="bg-white border-2 border-dashed border-gray-300 rounded-lg p-12 text-center">
    <p class="text-gray-500 text-lg">Aucun profil de montage n'a été créé pour le moment.</p>
    <p class="text-gray-400 text-sm mb-6">Commencez par en ajouter un pour voir le tableau.</p>
    <.link patch={~p"/profils/new"} class="text-blue-600 font-bold hover:underline">
      + Créer votre premier profil
    </.link>
  </div>
<% else %>
  <%!-- Ce bloc s'affiche dès que vous créez un profil --%>
  <div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nom</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <tr :for={profil <- @profils} id={"profil-#{profil.id}"} class="hover:bg-gray-50">
          <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= profil.name %></td>
          <td class="px-6 py-4 text-sm text-gray-500 italic"><%= profil.object_type %></td>
          <td class="px-6 py-4 text-right text-sm font-medium space-x-4">
             <.link patch={~p"/profils/#{profil.id}/edit"} class="text-indigo-600 hover:text-indigo-900">Modifier</.link>
             <button phx-click="delete" phx-value-id={profil.id} phx-confirm="Confirmer la suppression ?" class="text-red-600 hover:text-red-900">Supprimer</button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>