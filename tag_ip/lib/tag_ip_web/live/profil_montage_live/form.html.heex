<TagIpWeb.Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-4xl mx-auto my-10">
    <div class="bg-white border border-gray-200 shadow-sm rounded-2xl p-8">
      <div class="mb-2">
        <h1 class="text-2xl font-bold text-gray-900">{@page_title}</h1>
        <p class="text-sm text-gray-500 mt-1">
          Définissez les besoins du client pour trouver automatiquement les traceurs compatibles
        </p>
      </div>

      <%!-- Progress Steps --%>
      <div class="relative mb-10 mt-8">
        <div class="flex items-center justify-between">
          <div :for={s <- @steps} class="flex items-center flex-1 last:flex-none">
            <div class="flex flex-col items-center">
              <div class={[
                "w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold border-2 transition-all duration-300",
                s.num < @step && "bg-blue-600 border-blue-600 text-white",
                s.num == @step && "bg-white border-blue-600 text-blue-600 shadow-md",
                s.num > @step && "bg-gray-100 border-gray-300 text-gray-400"
              ]}>
                <.icon :if={s.num < @step} name="hero-check" class="w-5 h-5 text-white" />
                <span :if={s.num >= @step}>{s.num}</span>
              </div>
              <span class={[
                "text-xs mt-2 font-medium transition-colors duration-300 text-center",
                s.num <= @step && "text-blue-700",
                s.num > @step && "text-gray-400"
              ]}>
                {s.title}
              </span>
            </div>
            <div
              :if={s.num < @total_steps}
              class={[
                "flex-1 h-1 mx-4 rounded transition-all duration-500",
                s.num < @step && "bg-blue-600",
                s.num >= @step && "bg-gray-200"
              ]}
            />
          </div>
        </div>
      </div>

      <%!-- Progress Bar --%>
      <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden mb-8">
        <div
          class="bg-linear-to-r from-blue-500 to-blue-600 h-full rounded-full transition-all duration-500 ease-out shadow-sm"
          style="width: {(@step / @total_steps) * 100}%"
        />
      </div>

      <%!-- ==================== STEP 1: IDENTIFICATION ==================== --%>
      <div :if={@step == 1}>
        <form phx-submit="next-step" class="contents">
          <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm font-bold">
                1
              </div>
              <div>
                <h2 class="text-lg font-semibold text-gray-900">Identification du profil</h2>
                <p class="text-sm text-gray-500">
                  Saisissez le nom, le type de véhicule et la description
                </p>
              </div>
            </div>
            <div class="grid gap-6">
              <div>
                <label for="profile_name" class="block text-sm font-medium text-gray-700 mb-1">
                  Nom du profil <span class="text-red-500">*</span>
                </label>
                <input
                  id="profile_name"
                  name="profile_name"
                  type="text"
                  value={@profile_name}
                  placeholder="ex: Camion Teltonika FMP100"
                  phx-change="update_name"
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                  required
                />
              </div>
              <div>
                <label
                  for="organisation_select"
                  class="block text-sm font-medium text-gray-700 mb-1"
                >
                  Organisation cliente <span class="text-red-500">*</span>
                </label>
                <div class="flex gap-2">
                  <select
                    id="organisation_select"
                    name="organisation_id"
                    phx-change="select_organisation"
                    class="flex-1 px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                  >
                    <option value="">Sélectionnez une organisation</option>
                    <option
                      :for={org <- @organisations}
                      value={org.id}
                      selected={@selected_organisation_id == org.id}
                    >
                      {org.name}
                    </option>
                  </select>
                  <button
                    type="button"
                    phx-click="open_new_org_modal"
                    class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 text-sm font-medium rounded-lg border border-dashed border-blue-300 text-blue-700 bg-blue-50 hover:bg-blue-100 hover:border-blue-400 transition-all duration-150"
                    title="Ajouter une organisation"
                  >
                    <.icon name="hero-plus" class="size-4" />
                  </button>
                </div>
                <p class="text-xs text-gray-400 mt-1">
                  Organisation cliente à laquelle ce profil est rattaché.
                </p>
              </div>
              <div>
                <label
                  for="type_vehicule_select"
                  class="block text-sm font-medium text-gray-700 mb-1"
                >
                  Type de véhicule <span class="text-red-500">*</span>
                </label>
                <select
                  id="type_vehicule_select"
                  name="type_vehicule_id"
                  phx-change="select_type_vehicule"
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                >
                  <option value="">Sélectionnez un type de véhicule</option>
                  <option
                    :for={tv <- @types_vehicule}
                    value={tv.id}
                    selected={@selected_type_vehicule_id == tv.id}
                  >
                    {tv.label} ({tv.slug})
                  </option>
                </select>
                <p class="text-xs text-gray-400 mt-1">
                  Le type de véhicule détermine automatiquement les caractéristiques techniques du profil de montage.
                </p>
              </div>
              <div :if={@selected_type_vehicule}>
                <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-4 text-sm">
                  <p class="font-medium text-emerald-800 mb-2 flex items-center gap-2">
                    <.icon name="hero-check-circle" class="w-4 h-4" />
                    Caractéristiques dérivées du véhicule
                  </p>
                  <div class="grid grid-cols-2 gap-2 text-emerald-700">
                    <span>Tension : {@voltage_min}V – {@voltage_max}V</span>
                    <span>Object type : {@object_type}</span>
                    <span>Entrées requises : {@inputs_requis || "—"}</span>
                    <span>Sorties requises : {@outputs_requis || "—"}</span>
                  </div>
                </div>
              </div>
              <div>
                <label
                  for="alimentation_select"
                  class="block text-sm font-medium text-gray-700 mb-1"
                >
                  Alimentation
                </label>
                <select
                  id="alimentation_select"
                  name="alimentation_id"
                  phx-change="select_alimentation"
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                >
                  <option value="">Sélectionnez une alimentation</option>
                  <option
                    :for={alim <- @alimentations}
                    value={alim.id}
                    selected={@selected_alimentation_id == alim.id}
                  >
                    {alim.label} ({alim.category})
                  </option>
                </select>
                <p class="text-xs text-gray-400 mt-1">
                  Le type d'alimentation peut ajuster la plage de tension du profil.
                </p>
              </div>
              <div>
                <label
                  for="profile_description"
                  class="block text-sm font-medium text-gray-700 mb-1"
                >
                  Description (optionnel)
                </label>
                <textarea
                  id="profile_description"
                  name="profile_description"
                  placeholder="Détails sur l'installation physique, remarques..."
                  phx-change="update_description"
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                  rows="3"
                >{@profile_description}</textarea>
              </div>
            </div>
          </div>

          <%!-- Boutons inside step 1 form --%>
          <div class="flex items-center justify-between pt-6 border-t border-gray-200">
            <div></div>
            <div class="flex items-center gap-4">
              <.link
                navigate={~p"/dashboard"}
                class="text-sm font-medium text-gray-400 hover:text-gray-600 transition-colors"
              >
                Annuler
              </.link>
              <button
                type="submit"
                class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm hover:shadow-md transition-all"
              >
                Suivant <.icon name="hero-chevron-right" class="w-4 h-4" />
              </button>
            </div>
          </div>
        </form>
      </div>

      <%!-- ==================== STEP 2: FONCTIONNALITÉS & CRITÈRES ==================== --%>
      <div :if={@step == 2}>
        <form phx-submit="next-step" class="contents">
          <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm font-bold">
                2
              </div>
              <div>
                <h2 class="text-lg font-semibold text-gray-900">Fonctionnalités & Critères</h2>
                <p class="text-sm text-gray-500">
                  Sélectionnez les fonctionnalités et exigences techniques du client
                </p>
              </div>
            </div>

            <div
              :if={@selected_type_vehicule}
              class="mb-4 bg-indigo-50 border border-indigo-200 rounded-lg p-3 text-sm text-indigo-700 flex items-center gap-2"
            >
              <.icon name="hero-truck" class="w-4 h-4 shrink-0" /> Véhicule sélectionné :
              <strong>{@selected_type_vehicule.label}</strong>
              <span class="text-indigo-400">({@object_type})</span>
            </div>

            <%!-- Fonctionnalités de la matrice --%>
            <div class="mb-6">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                Fonctionnalités
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <label
                  :for={feat <- @matrix_features}
                  class={[
                    "flex items-start gap-3 p-4 bg-white rounded-xl border-2 cursor-pointer transition-all duration-200",
                    if(MapSet.member?(@selected_features, feat.slug),
                      do: "border-blue-500 bg-blue-50 shadow-sm",
                      else: "border-gray-200 hover:border-blue-300 hover:shadow-sm"
                    )
                  ]}
                >
                  <div class="shrink-0 mt-0.5">
                    <div class={[
                      "w-5 h-5 rounded-md border-2 flex items-center justify-center transition-all",
                      MapSet.member?(@selected_features, feat.slug) &&
                        "bg-blue-600 border-blue-600",
                      !MapSet.member?(@selected_features, feat.slug) && "bg-white border-gray-300"
                    ]}>
                      <.icon
                        :if={MapSet.member?(@selected_features, feat.slug)}
                        name="hero-check"
                        class="w-3.5 h-3.5 text-white"
                      />
                    </div>
                  </div>
                  <div
                    class="flex-1 min-w-0"
                    phx-click="toggle_feature"
                    phx-value-slug={feat.slug}
                  >
                    <span class="text-sm font-medium text-gray-900 block">{feat.label}</span>
                    <span class="text-xs text-gray-500">{feat.description}</span>
                  </div>
                </label>
              </div>
            </div>

            <%!-- Interfaces de communication --%>
            <div class="mb-6">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                Interfaces de communication
              </h3>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                <label
                  :for={
                    field <- [
                      "can_bus_requis",
                      "one_wire_requis",
                      "rs232_requis",
                      "rs485_requis",
                      "bluetooth_ble_requis"
                    ]
                  }
                  class={[
                    "flex items-center gap-3 p-3 rounded-lg border cursor-pointer transition-all",
                    Map.get(assigns, String.to_existing_atom(field)) &&
                      "bg-blue-50 border-blue-300",
                    !Map.get(assigns, String.to_existing_atom(field)) &&
                      "bg-white border-gray-200 hover:border-gray-300"
                  ]}
                >
                  <input
                    type="checkbox"
                    checked={Map.get(assigns, String.to_existing_atom(field))}
                    phx-click="toggle_criteria"
                    phx-value-field={field}
                    class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-700">
                    {case field do
                      "can_bus_requis" -> "CAN-Bus"
                      "one_wire_requis" -> "1-Wire"
                      "rs232_requis" -> "RS232"
                      "rs485_requis" -> "RS485"
                      "bluetooth_ble_requis" -> "Bluetooth BLE"
                    end}
                  </span>
                </label>
              </div>
            </div>

            <%!-- Entrées / Sorties --%>
            <div class="mb-6">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                Entrées / Sorties (I/O)
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">
                    Entrées numériques
                  </label>
                  <input
                    type="number"
                    min="0"
                    value={@inputs_requis || 0}
                    phx-change="update_criteria_int"
                    phx-value-field="inputs_requis"
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">
                    Entrées analogiques
                  </label>
                  <input
                    type="number"
                    min="0"
                    value={@analog_inputs_requis || 0}
                    phx-change="update_criteria_int"
                    phx-value-field="analog_inputs_requis"
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">
                    Sorties numériques
                  </label>
                  <input
                    type="number"
                    min="0"
                    value={@outputs_requis || 0}
                    phx-change="update_criteria_int"
                    phx-value-field="outputs_requis"
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                  />
                </div>
              </div>
            </div>

            <%!-- Environnement & Protection --%>
            <div class="mb-6">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                Environnement & Protection
              </h3>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                <label
                  :for={
                    field <- [
                      "montage_exterieur",
                      "antenne_deportee",
                      "accelerometre_requis",
                      "ultra_low_power_requis",
                      "buzzer",
                      "geofence_enabled"
                    ]
                  }
                  class={[
                    "flex items-center gap-3 p-3 rounded-lg border cursor-pointer transition-all",
                    Map.get(assigns, String.to_existing_atom(field)) &&
                      "bg-blue-50 border-blue-300",
                    !Map.get(assigns, String.to_existing_atom(field)) &&
                      "bg-white border-gray-200 hover:border-gray-300"
                  ]}
                >
                  <input
                    type="checkbox"
                    checked={Map.get(assigns, String.to_existing_atom(field))}
                    phx-click="toggle_criteria"
                    phx-value-field={field}
                    class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-700">
                    {case field do
                      "montage_exterieur" -> "Montage extérieur (IP67+)"
                      "antenne_deportee" -> "Antenne déportée"
                      "accelerometre_requis" -> "Accéléromètre"
                      "ultra_low_power_requis" -> "Ultra Low Power"
                      "buzzer" -> "Buzzer"
                      "geofence_enabled" -> "Géofence"
                    end}
                  </span>
                </label>
              </div>
            </div>

            <%!-- Sonde carburant --%>
            <div class="mb-6">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                Sonde carburant
              </h3>
              <select
                phx-change="select_fuel_probe"
                class="w-full md:w-1/2 px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
              >
                <option value="" selected={@fuel_probe_type in [nil, "", "none"]}>
                  Aucune
                </option>
                <option
                  value="analog"
                  selected={@fuel_probe_type == "analog"}
                >
                  Sonde analogique
                </option>
                <option
                  value="rs232"
                  selected={@fuel_probe_type == "rs232"}
                >
                  Sonde RS232
                </option>
                <option
                  value="ble"
                  selected={@fuel_probe_type == "ble"}
                >
                  Sonde Bluetooth BLE
                </option>
                <option
                  value="can"
                  selected={@fuel_probe_type == "can"}
                >
                  Sonde CAN-Bus
                </option>
              </select>
            </div>

            <%!-- Capteurs --%>
            <div :if={@capteurs != []} class="mb-6">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                Capteurs requis
              </h3>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                <label
                  :for={capteur <- @capteurs}
                  class={[
                    "flex items-center gap-2 p-3 rounded-lg border cursor-pointer transition-colors",
                    MapSet.member?(@selected_capteur_ids, capteur.id) &&
                      "bg-blue-50 border-blue-300",
                    !MapSet.member?(@selected_capteur_ids, capteur.id) &&
                      "bg-white border-gray-200 hover:bg-blue-50 hover:border-blue-200"
                  ]}
                >
                  <input
                    type="checkbox"
                    checked={MapSet.member?(@selected_capteur_ids, capteur.id)}
                    phx-click="toggle_capteur"
                    phx-value-id={capteur.id}
                    class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                  />
                  <span class="text-sm text-gray-700">{capteur.label}</span>
                </label>
              </div>
            </div>

            <%!-- Périphériques --%>
            <div :if={@peripherals != []} class="mb-6">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                Périphériques requis
              </h3>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                <label
                  :for={periph <- @peripherals}
                  class={[
                    "flex items-center gap-2 p-3 rounded-lg border cursor-pointer transition-colors",
                    MapSet.member?(@selected_peripheral_ids, periph.id) &&
                      "bg-blue-50 border-blue-300",
                    !MapSet.member?(@selected_peripheral_ids, periph.id) &&
                      "bg-white border-gray-200 hover:bg-blue-50 hover:border-blue-200"
                  ]}
                >
                  <input
                    type="checkbox"
                    checked={MapSet.member?(@selected_peripheral_ids, periph.id)}
                    phx-click="toggle_peripheral"
                    phx-value-id={periph.id}
                    class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                  />
                  <span class="text-sm text-gray-700">{periph.name}</span>
                </label>
              </div>
            </div>

            <%!-- Résumé des sélections --%>
            <div
              :if={MapSet.size(@selected_features) > 0}
              class="mt-4 bg-blue-100/50 border border-blue-200 rounded-lg p-3 text-sm text-blue-800 flex items-start gap-2"
            >
              <.icon name="hero-check-circle" class="w-5 h-5 mt-0.5 shrink-0 text-blue-600" />
              <span>
                {MapSet.size(@selected_features)} fonctionnalité(s) sélectionnée(s).
              </span>
            </div>
          </div>

          <%!-- Boutons inside step 2 form --%>
          <div class="flex items-center justify-between pt-6 border-t border-gray-200">
            <div>
              <button
                type="button"
                phx-click="prev-step"
                class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:border-gray-400 transition-all shadow-sm"
              >
                <.icon name="hero-chevron-left" class="w-4 h-4" /> Précédent
              </button>
            </div>
            <div class="flex items-center gap-4">
              <.link
                navigate={~p"/dashboard"}
                class="text-sm font-medium text-gray-400 hover:text-gray-600 transition-colors"
              >
                Annuler
              </.link>
              <button
                type="submit"
                class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm hover:shadow-md transition-all"
              >
                <.icon name="hero-magnifying-glass" class="w-4 h-4" />
                Trouver les traceurs compatibles
              </button>
            </div>
          </div>
        </form>
      </div>

      <%!-- ==================== STEP 3: MODÈLE TRACEUR (SUGGESTIONS) ==================== --%>
      <div :if={@step == 3}>
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm font-bold">
              3
            </div>
            <div>
              <h2 class="text-lg font-semibold text-gray-900">Modèles compatibles</h2>
              <p class="text-sm text-gray-500">
                Le système a calculé la compatibilité de chaque modèle avec vos critères
              </p>
            </div>
          </div>

          <%!-- Résumé des critères --%>
          <div class="bg-white rounded-xl border border-gray-200 p-4 mb-4">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">
              Critères recherchés
            </h3>
            <div class="flex flex-wrap gap-2">
              <span
                :if={@selected_type_vehicule}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-indigo-100 text-indigo-800 border border-indigo-200"
              >
                {@selected_type_vehicule.label}
              </span>
              <span
                :if={@voltage_min && @voltage_max}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200"
              >
                {@voltage_min}V – {@voltage_max}V
              </span>
              <span
                :for={slug <- MapSet.to_list(@selected_features)}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200"
              >
                {feature_label(slug)}
              </span>
              <span
                :if={@can_bus_requis}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200"
              >
                CAN-Bus
              </span>
              <span
                :if={@rs232_requis}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200"
              >
                RS232
              </span>
              <span
                :if={@bluetooth_ble_requis}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200"
              >
                Bluetooth BLE
              </span>
              <span
                :if={@montage_exterieur}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200"
              >
                Montage extérieur
              </span>
              <span
                :if={@accelerometre_requis}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200"
              >
                Accéléromètre
              </span>
              <span
                :if={@buzzer}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200"
              >
                Buzzer
              </span>
              <span
                :if={@fuel_probe_type not in [nil, "", "none"]}
                class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200"
              >
                Sonde carburant ({@fuel_probe_type})
              </span>
            </div>
          </div>

          <%!-- Résultats --%>
          <div
            :if={@compatible_models == []}
            class="bg-white rounded-xl border border-gray-200 p-8 text-center"
          >
            <.icon name="hero-magnifying-glass" class="w-10 h-10 text-gray-300 mx-auto mb-3" />
            <p class="text-gray-500 font-medium">Aucun modèle compatible trouvé</p>
            <p class="text-sm text-gray-400 mt-1">
              Essayez d'assouplir certains critères à l'étape précédente.
            </p>
          </div>

          <div :if={@compatible_models != []} class="space-y-3">
            <div
              :for={result <- @compatible_models}
              class={[
                "bg-white rounded-xl border-2 p-4 cursor-pointer transition-all duration-200",
                @selected_model_id == result.modele.id && "border-blue-500 bg-blue-50 shadow-md",
                @selected_model_id != result.modele.id &&
                  "border-gray-200 hover:border-blue-300 hover:shadow-sm"
              ]}
              phx-click="select_model"
              phx-value-model_id={result.modele.id}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 mb-1">
                    <input
                      type="radio"
                      name="model_id"
                      value={result.modele.id}
                      checked={@selected_model_id == result.modele.id}
                      class="text-blue-600 focus:ring-blue-500"
                    />
                    <h4 class="text-base font-bold text-gray-900">
                      {result.modele.nom}
                    </h4>
                    <span
                      :if={result.modele.brand}
                      class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full"
                    >
                      {result.modele.brand}
                    </span>
                    <span class={[
                      "text-xs font-semibold px-2 py-0.5 rounded-full",
                      result.compatible && "bg-green-100 text-green-700",
                      !result.compatible && "bg-gray-100 text-gray-500"
                    ]}>
                      {if result.compatible, do: "Compatible", else: "Non compatible"}
                    </span>
                  </div>
                  <p
                    :if={result.modele.reference}
                    class="text-xs text-gray-400 ml-8"
                  >
                    Réf: {result.modele.reference}
                  </p>

                  <%!-- Score bar --%>
                  <div class="flex items-center gap-3 mt-2 ml-8">
                    <div class="flex-1 max-w-xs bg-gray-200 rounded-full h-2.5">
                      <div
                        class={[
                          "h-2.5 rounded-full transition-all duration-500",
                          score_bar_color(result.score)
                        ]}
                        style="width: {result.score}%"
                      />
                    </div>
                    <span class={[
                      "inline-flex items-center px-2.5 py-0.5 text-xs font-bold rounded-full border",
                      score_color(result.score)
                    ]}>
                      {result.score}%
                    </span>
                  </div>
                </div>
              </div>

              <%!-- Fiche technique --%>
              <div class="mt-3 ml-8 grid grid-cols-2 md:grid-cols-4 gap-3 text-xs text-gray-500">
                <span>
                  Tension: {if result.modele.voltage_min,
                    do: "#{result.modele.voltage_min}V",
                    else: "N/A"} – {if result.modele.voltage_max,
                    do: "#{result.modele.voltage_max}V",
                    else: "N/A"}
                </span>
                <span>
                  I/O: {result.modele.nb_digital_inputs || 0} DIN / {result.modele.nb_analog_inputs ||
                    0} AIN / {result.modele.nb_outputs || 0} DOUT
                </span>
                <span>
                  IP: {result.modele.ip_rating || "N/A"}
                </span>
                <span>
                  Accél: {if result.modele.accelerometer, do: "✓", else: "✗"}
                </span>
              </div>

              <%!-- Détails --%>
              <details :if={result.details != ""} class="mt-3 ml-8 group">
                <summary class="text-xs font-medium text-gray-400 cursor-pointer hover:text-gray-600 transition-colors select-none">
                  Voir les détails de compatibilité
                </summary>
                <div class="mt-2 text-xs text-gray-600 bg-gray-50 p-3 rounded-lg border border-gray-100 whitespace-pre-wrap font-mono leading-relaxed">
                  {result.details}
                </div>
              </details>
            </div>
          </div>

          <%!-- Nombre de résultats --%>
          <div
            :if={@compatible_models != []}
            class="mt-4 text-xs text-gray-500 text-center"
          >
            {Enum.count(@compatible_models, & &1.compatible)} compatible(s) sur {@compatible_models
            |> length()} modèle(s) affiché(s)
          </div>
        </div>
      </div>

      <%!-- ==================== STEP 4: VALIDATION FINALE ==================== --%>
      <div :if={@step == 4}>
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm font-bold">
              4
            </div>
            <div>
              <h2 class="text-lg font-semibold text-gray-900">Validation finale</h2>
              <p class="text-sm text-gray-500">
                Récapitulatif et vérification de la compatibilité
              </p>
            </div>
          </div>

          <%!-- Résumé --%>
          <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4 mb-6">
            <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">
              Récapitulatif
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="p-3 bg-gray-50 rounded-lg">
                <p class="text-xs text-gray-500 mb-1">Nom du profil</p>
                <p class="text-sm font-medium text-gray-900">{@profile_name}</p>
              </div>
              <div class="p-3 bg-gray-50 rounded-lg">
                <p class="text-xs text-gray-500 mb-1">Description</p>
                <p class="text-sm text-gray-700">
                  {if @profile_description != "", do: @profile_description, else: "—"}
                </p>
              </div>
              <div class="p-3 bg-gray-50 rounded-lg">
                <p class="text-xs text-gray-500 mb-1">Type de véhicule</p>
                <p class="text-sm font-medium text-gray-900">
                  {@selected_type_vehicule && @selected_type_vehicule.label}
                  <span class="text-gray-500">({@object_type})</span>
                </p>
              </div>
              <div class="p-3 bg-gray-50 rounded-lg">
                <p class="text-xs text-gray-500 mb-1">Modèle sélectionné</p>
                <p class="text-sm font-medium text-gray-900">
                  {@selected_model && @selected_model.nom}
                  <span class="text-gray-500">
                    ({@selected_model && @selected_model.reference})
                  </span>
                </p>
              </div>
            </div>

            <div>
              <p class="text-xs text-gray-500 mb-2">Fonctionnalités sélectionnées</p>
              <div
                :if={Enum.empty?(MapSet.to_list(@selected_features))}
                class="text-sm text-gray-400 italic"
              >
                Aucune fonctionnalité sélectionnée
              </div>
              <div
                :if={!Enum.empty?(MapSet.to_list(@selected_features))}
                class="flex flex-wrap gap-2"
              >
                <div
                  :for={slug <- MapSet.to_list(@selected_features)}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-100 text-blue-800 rounded-full text-xs font-medium"
                >
                  <.icon name="hero-check" class="w-3.5 h-3.5" />
                  {feature_label(slug)}
                </div>
              </div>
            </div>
          </div>

          <%!-- Résultat validation --%>
          <div :if={@validation_result}>
            <div
              :if={@validation_result.valid?}
              class="bg-emerald-50 border border-emerald-200 rounded-xl p-5 mb-4"
            >
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
                  <.icon name="hero-check" class="w-6 h-6 text-emerald-600" />
                </div>
                <div>
                  <h3 class="text-base font-semibold text-emerald-800">Profil valide</h3>
                  <p class="text-sm text-emerald-700 mt-1">
                    Toutes les fonctionnalités sélectionnées sont compatibles avec le modèle {@selected_model &&
                      @selected_model.nom}.
                  </p>
                </div>
              </div>
            </div>

            <div
              :if={!@validation_result.valid?}
              class="bg-red-50 border border-red-200 rounded-xl p-5 mb-4"
            >
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center shrink-0">
                  <.icon name="hero-x-mark" class="w-6 h-6 text-red-600" />
                </div>
                <div>
                  <h3 class="text-base font-semibold text-red-800">Incompatibilité détectée</h3>
                  <p class="text-sm text-red-700 mt-1">
                    Corrigez les points suivants avant d'enregistrer :
                  </p>
                  <ul class="mt-2 space-y-1">
                    <li
                      :for={error <- @validation_result.errors}
                      class="text-sm text-red-700 flex items-start gap-2"
                    >
                      <.icon name="hero-x-circle" class="w-4 h-4 mt-0.5 shrink-0 text-red-500" />
                      <span>{error}</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4 text-xs text-gray-500 bg-white rounded-lg border border-blue-200 p-3">
            <p>
              Validation selon la matrice de capacités : le système vérifie que toutes les fonctionnalités
              sélectionnées sont supportées par le modèle <strong>{@selected_model && @selected_model.nom}</strong>.
            </p>
          </div>
        </div>

        <%!-- Message succès --%>
        <div
          :if={@profile_saved}
          class="bg-emerald-50 border border-emerald-200 rounded-xl p-6 mb-6 text-center"
        >
          <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
            <.icon name="hero-check-circle" class="w-8 h-8 text-emerald-600" />
          </div>
          <h3 class="text-lg font-semibold text-emerald-800">Profil enregistré !</h3>
          <p class="text-sm text-emerald-700 mt-1 mb-4">
            Le profil <strong>{@profile_name}</strong> a été créé avec succès.
          </p>
          <.link
            navigate={~p"/profils/#{@saved_profile_id}"}
            class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition text-sm font-medium"
          >
            Voir le profil
          </.link>
        </div>
      </div>

      <%!-- ==================== BOUTONS (Steps 3 & 4) ==================== --%>
      <div
        :if={!@profile_saved && @step >= 3}
        class="flex items-center justify-between pt-6 border-t border-gray-200"
      >
        <div>
          <button
            type="button"
            phx-click="prev-step"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:border-gray-400 transition-all shadow-sm"
          >
            <.icon name="hero-chevron-left" class="w-4 h-4" /> Précédent
          </button>
        </div>

        <div class="flex items-center gap-4">
          <.link
            navigate={~p"/dashboard"}
            class="text-sm font-medium text-gray-400 hover:text-gray-600 transition-colors"
          >
            Annuler
          </.link>

          <button
            :if={@step == 3}
            type="button"
            phx-click="next-step"
            class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm hover:shadow-md transition-all"
          >
            Suivant <.icon name="hero-chevron-right" class="w-4 h-4" />
          </button>

          <button
            :if={@step == @total_steps && @validation_result && @validation_result.valid?}
            type="button"
            phx-click="save"
            class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 shadow-sm hover:shadow-md transition-all"
          >
            <.icon name="hero-check" class="w-4 h-4" /> Enregistrer le profil
          </button>
        </div>
      </div>
    </div>
  </div>

  <div
    id="new-org-modal"
    class={[
      "fixed inset-0 z-50 flex items-center justify-center transition-all duration-200",
      !@show_new_org_modal && "hidden"
    ]}
    role="dialog"
    aria-modal="true"
  >
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm" phx-click="close_new_org_modal"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl max-w-md w-full mx-4 p-6 transform transition-all">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-bold text-gray-900">Nouvelle organisation</h3>
        <button
          type="button"
          phx-click="close_new_org_modal"
          class="p-1 text-gray-400 hover:text-gray-600 transition-colors"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>

      <.form for={@new_org_form} id="new-org-form" phx-submit="save_new_org">
        <.input
          field={@new_org_form[:name]}
          type="text"
          label="Nom"
          placeholder="Nom de l'organisation"
          required
        />
        <.input
          field={@new_org_form[:slug]}
          type="text"
          label="Slug"
          placeholder="nom-de-l-organisation"
          required
        />
        <.input
          field={@new_org_form[:description]}
          type="textarea"
          label="Description"
          placeholder="Optionnelle"
        />

        <div class="flex justify-end gap-3 mt-6">
          <button
            type="button"
            phx-click="close_new_org_modal"
            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-xl transition-colors"
          >
            Annuler
          </button>
          <button
            type="submit"
            class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-all"
          >
            Ajouter
          </button>
        </div>
      </.form>
    </div>
  </div>
</TagIpWeb.Layouts.app>
