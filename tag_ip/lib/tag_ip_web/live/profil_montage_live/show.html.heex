<TagIpWeb.Layouts.app flash={@flash}>
  <div class="mb-8">
    <.header>
      {@page_title}
      <:subtitle>Détails du profil de montage pour TAG-Monitor</:subtitle>
    </.header>
  </div>

  <div class="max-w-3xl mx-auto">
    <div class="md:grid md:grid-cols-3 md:gap-6">
      <div class="md:col-span-1">
        <div class="px-4 sm:px-0">
          <h3 class="text-lg font-medium leading-6 text-gray-900">Détails du profil</h3>
          <p class="mt-1 text-sm text-gray-600">
            Informations détaillées sur le profil de montage.
          </p>
        </div>
      </div>

      <div class="mt-5 md:col-span-2 md:mt-0">
        <div class="shadow-sm rounded-xl bg-white p-6 border border-gray-100">
          <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Nom</dt>
              <dd class="mt-1 text-sm text-gray-900">{@profil.name}</dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Type d'objet</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {Map.get(@type_labels, @profil.object_type, @profil.object_type) || "Non défini"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Intervalle de rapport</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@profil.reporting_interval || "Non défini"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Tension min/max (mV)</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@profil.voltage_min} / {@profil.voltage_max}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Sonde carburant</dt>
              <dd class="mt-1 text-sm text-gray-900">{@profil.fuel_probe_type || "Aucune"}</dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">ID Chauffeur</dt>
              <dd class="mt-1 text-sm text-gray-900">{@profil.driver_id_type || "Aucun"}</dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Buzzer</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @profil.buzzer, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Geofencing</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @profil.geofence_enabled, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">CAN-Bus requis</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @profil.can_bus_requis, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">1-Wire requis</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @profil.one_wire_requis, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">RS232 / RS485 requis</dt>
              <dd class="mt-1 text-sm text-gray-900">
                RS232: {if @profil.rs232_requis, do: "Oui", else: "Non"} — RS485: {if @profil.rs485_requis,
                  do: "Oui",
                  else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Entrées / Sorties requises</dt>
              <dd class="mt-1 text-sm text-gray-900">
                Num: {@profil.inputs_requis || 0} / Ana: {@profil.analog_inputs_requis || 0} / Out: {@profil.outputs_requis ||
                  0}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Indice IP requis</dt>
              <dd class="mt-1 text-sm text-gray-900">{@profil.ip_rating || "Non spécifié"}</dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Montage extérieur</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @profil.montage_exterieur, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Antennes déportées</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @profil.antenne_deportee, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Accéléromètre requis</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @profil.accelerometre_requis, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Buffer mémoire requis</dt>
              <dd class="mt-1 text-sm text-gray-900">{@profil.buffer_requis || 0} MB</dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Ultra-Low Power requis</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @profil.ultra_low_power_requis, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@profil.description || "Aucune description"}
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Créé le</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@inserted_at_formatted}
              </dd>
            </div>
          </dl>

          <div class="mt-8 pt-6 border-t border-gray-100 flex space-x-3">
            <.link
              navigate={~p"/profils/#{@profil.id}/edit"}
              class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-sm font-semibold rounded-xl bg-blue-600 text-white hover:bg-blue-700 shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            >
              Modifier
            </.link>
            <.link
              navigate={~p"/profils"}
              class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-sm font-semibold rounded-xl border-2 border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-gray-400 shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
            >
              Retour
            </.link>
          </div>
        </div>

        <div class="mt-6 shadow-sm rounded-xl bg-white p-6 border border-gray-100">
          <h4 class="text-lg font-semibold text-gray-900 mb-4">Compatibilités calculées</h4>

          <ul class="divide-y divide-gray-100">
            <li
              :for={compat <- @compatibilites}
              id={"compat-#{compat.id}"}
              class="py-4 first:pt-0 last:pb-0"
            >
              <div class="flex items-center justify-between">
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900">
                    Modèle:
                    <span class="font-semibold">
                      {compat.modele_traceur.nom || compat.modele_traceur_id}
                    </span>
                  </p>
                  <p class="text-sm text-gray-500 mt-0.5">{compat.details}</p>
                </div>
                <div class="ml-4 shrink-0">
                  <span class={[
                    "inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full",
                    compat.score_compatibilite >= 70 && "bg-green-100 text-green-800",
                    compat.score_compatibilite >= 40 && compat.score_compatibilite < 70 &&
                      "bg-yellow-100 text-yellow-800",
                    compat.score_compatibilite < 40 && "bg-red-100 text-red-800"
                  ]}>
                    {compat.score_compatibilite}%
                  </span>
                </div>
              </div>
            </li>
          </ul>

          <div :if={Enum.empty?(@compatibilites)} class="text-center py-8 text-gray-400 italic">
            Aucune compatibilité calculée pour ce profil. Utilisez la page d'index pour calculer la compatibilité.
          </div>
        </div>
      </div>
    </div>
  </div>
</TagIpWeb.Layouts.app>
