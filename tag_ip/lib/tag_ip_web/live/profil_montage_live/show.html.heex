<TagIpWeb.Layouts.app flash={@flash}>
  <div class="mb-8">
    <.header>
      {@page_title}
      <:subtitle>Détails du profil de montage pour TAG-Monitor</:subtitle>
    </.header>
  </div>

  <div class="max-w-7xl mx-auto space-y-8">
    <div class="grid gap-6 lg:grid-cols-[1.15fr_1.85fr]">
      <section class="overflow-hidden rounded-[2rem] bg-slate-950 text-white shadow-xl ring-1 ring-slate-200/10">
        <div class="p-8 sm:p-10">
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">
                Profil
              </p>
              <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white">
                {@profil.name}
              </h1>
              <p class="mt-4 text-sm leading-6 text-slate-300">
                Ce profil décrit les exigences matérielles et les options de configuration pour un montage TAG-Monitor adapté.
              </p>
            </div>
            <div class="hidden sm:block rounded-3xl bg-slate-900/80 px-4 py-3 text-sm font-medium text-slate-200">
              {Map.get(@type_labels, @profil.object_type, @profil.object_type) || "Non défini"}
            </div>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-3xl bg-slate-900/80 p-5 ring-1 ring-slate-200/10">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-400">Compatibilités</dt>
              <dd class="mt-2 text-lg font-semibold text-white">{Enum.count(@compatibilites)}</dd>
            </div>
            <div class="rounded-3xl bg-slate-900/80 p-5 ring-1 ring-slate-200/10">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-400">Créé le</dt>
              <dd class="mt-2 text-base font-medium text-slate-200">{@inserted_at_formatted}</dd>
            </div>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-3xl bg-slate-900/80 p-5 ring-1 ring-slate-200/10">
              <p class="text-sm text-slate-400">Buzzer</p>
              <p class="mt-3 text-lg font-semibold text-white">
                {if @profil.buzzer, do: "Oui", else: "Non"}
              </p>
            </div>
            <div class="rounded-3xl bg-slate-900/80 p-5 ring-1 ring-slate-200/10">
              <p class="text-sm text-slate-400">Geofencing</p>
              <p class="mt-3 text-lg font-semibold text-white">
                {if @profil.geofence_enabled, do: "Oui", else: "Non"}
              </p>
            </div>
          </div>
        </div>

        <div class="border-t border-white/10 bg-slate-900/80 px-8 py-6">
          <div class="grid gap-3 sm:grid-cols-2">
            <.link
              navigate={"/profils/#{@profil.id}/edit?return_to=/profils/#{@profil.id}"}
              class="inline-flex items-center justify-center gap-2 rounded-3xl bg-white px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
            >
              Modifier
            </.link>
            <.link
              navigate={~p"/profils/new?duplicate_from=#{@profil.id}"}
              class="inline-flex items-center justify-center gap-2 rounded-3xl border border-teal-300 bg-teal-50 px-5 py-3 text-sm font-semibold text-teal-700 transition hover:bg-teal-100"
            >
              Dupliquer
            </.link>
            <button
              type="button"
              phx-click="confirm_delete"
              phx-value-id={@profil.id}
              class="inline-flex items-center justify-center gap-2 rounded-3xl border border-red-300 bg-red-50 px-5 py-3 text-sm font-semibold text-red-700 transition hover:bg-red-100"
            >
              Supprimer
            </button>
            <.link
              navigate={~p"/profils"}
              class="inline-flex items-center justify-center gap-2 rounded-3xl border border-slate-700 bg-slate-950 px-5 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-900"
            >
              Retour
            </.link>
          </div>
        </div>
      </section>

      <div class="space-y-6">
        <section class="overflow-hidden rounded-[2rem] bg-white p-8 shadow-sm ring-1 ring-slate-200/60">
          <div class="flex items-center justify-between gap-6">
            <div>
              <h2 class="text-xl font-semibold text-slate-900">Fiche technique</h2>
              <p class="mt-1 text-sm text-slate-500">
                Toutes les informations essentielles du profil.
              </p>
            </div>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700">
              Détails
            </span>
          </div>

          <dl class="mt-8 grid gap-5 sm:grid-cols-2">
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">
                Intervalle de rapport
              </dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {@profil.reporting_interval || "Non défini"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Tension min/max</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {@profil.voltage_min} / {@profil.voltage_max} mV
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Sonde carburant</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {@profil.fuel_probe_type || "Aucune"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">ID Chauffeur</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {@profil.driver_id_type || "Aucun"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Indice IP</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {@profil.ip_rating || "Non spécifié"}
              </dd>
            </div>
          </dl>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">RS232</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {if @profil.rs232_requis, do: "Oui", else: "Non"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">RS485</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {if @profil.rs485_requis, do: "Oui", else: "Non"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Montage extérieur</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {if @profil.montage_exterieur, do: "Oui", else: "Non"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Ultra-Low Power</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {if @profil.ultra_low_power_requis, do: "Oui", else: "Non"}
              </dd>
            </div>
          </div>
        </section>

        <section class="overflow-hidden rounded-[2rem] bg-white p-8 shadow-sm ring-1 ring-slate-200/60">
          <div class="flex items-center justify-between gap-6">
            <div>
              <h2 class="text-xl font-semibold text-slate-900">Compatibilités calculées</h2>
              <p class="mt-1 text-sm text-slate-500">
                Résultats triés par score de compatibilité.
              </p>
            </div>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700">
              {Enum.count(@compatibilites)} résultats
            </span>
          </div>

          <div class="mt-6 space-y-4">
            <div
              :if={Enum.empty?(@compatibilites)}
              class="rounded-3xl border border-dashed border-slate-200 bg-slate-50 p-8 text-center text-sm text-slate-500"
            >
              Aucune compatibilité calculée pour ce profil. Utilisez la page d'index pour calculer la compatibilité.
            </div>

            <ul class="space-y-4">
              <li
                :for={compat <- @compatibilites}
                id={"compat-#{compat.id}"}
                class="rounded-3xl border border-slate-200 p-5 shadow-sm"
              >
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <p class="text-sm text-slate-500">Modèle compatible</p>
                    <p class="mt-1 text-base font-semibold text-slate-900">
                      {compat.modele_traceur.nom || compat.modele_traceur_id}
                    </p>
                    <p class="mt-2 text-sm leading-6 text-slate-600">{compat.details}</p>
                  </div>
                  <span class={[
                    "inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold",
                    compat.score_compatibilite >= 70 && "bg-emerald-100 text-emerald-800",
                    compat.score_compatibilite >= 40 && compat.score_compatibilite < 70 &&
                      "bg-amber-100 text-amber-800",
                    compat.score_compatibilite < 40 && "bg-rose-100 text-rose-800"
                  ]}>
                    {compat.score_compatibilite}%
                  </span>
                </div>
              </li>
            </ul>
          </div>
        </section>
      </div>
      <.confirm_modal show={@pending_delete_id != nil}>
        Êtes-vous sûr de vouloir supprimer <strong>{@pending_delete_label}</strong> ?
        Cette action est irréversible.
      </.confirm_modal>
    </div>
  </div>
</TagIpWeb.Layouts.app>
