<TagIpWeb.Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-5xl mx-auto py-4">
    <div class="mb-8">
      <.header>
        {if @modele, do: "Modifier le modèle", else: "Nouveau modèle"}
        <:subtitle>
          Définissez les caractéristiques techniques du traceur pour assurer la compatibilité avec les profils de montage.
        </:subtitle>
      </.header>
    </div>

    <div class="mt-5">
      <.form
        for={@form}
        id="modele-form"
        phx-submit="save"
        phx-change="validate"
        class="space-y-6"
      >
        <div class="shadow-md rounded-xl bg-white p-8 border border-gray-100">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6">
            <div class="sm:col-span-2">
              <.input
                field={@form[:nom]}
                type="text"
                label="Nom du modèle"
                placeholder="Ex: Teltonika FMB920"
                required
              />
            </div>

            <div class="sm:col-span-1">
              <.input
                field={@form[:brand]}
                type="text"
                label="Marque"
                placeholder="Ex: Teltonika, Systech"
              />
            </div>

            <div class="sm:col-span-1">
              <.input
                field={@form[:reference]}
                type="text"
                label="Référence interne"
                placeholder="REF-XXXX"
                required
              />
            </div>

            <%!-- === Types de véhicules : Dropdown multiselect avec recherche === --%>
            <div class="sm:col-span-2">
              <label class="block text-sm font-semibold text-gray-700 mb-2">
                Véhicules compatibles
              </label>

              <%!-- Selected tags --%>
              <div class="flex flex-wrap gap-1.5 mb-3 min-h-[2rem]">
                <%= if Enum.empty?(@selected_type_vehicule_ids) do %>
                  <span class="text-xs text-gray-400 italic">Aucun véhicule sélectionné</span>
                <% end %>
                <span
                  :for={
                    tv <-
                      Enum.filter(
                        @types_vehicule,
                        &MapSet.member?(@selected_type_vehicule_ids, &1.id)
                      )
                  }
                  phx-click="toggle_type_vehicule"
                  phx-value-id={tv.id}
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-semibold cursor-pointer hover:bg-blue-200 transition-colors"
                >
                  {tv.label}
                  <span class="text-blue-500 hover:text-blue-700 ml-0.5">&times;</span>
                </span>
              </div>

              <%!-- Dropdown trigger --%>
              <div class="relative" phx-click-away="close_type_vehicule_dropdown">
                <button
                  type="button"
                  phx-click="toggle_type_vehicule_dropdown"
                  class={[
                    "w-full flex items-center justify-between px-3 py-2 text-sm border rounded-lg transition-all duration-150",
                    if(@show_type_vehicule_dropdown,
                      do: "border-blue-400 ring-2 ring-blue-200",
                      else: "border-gray-300 hover:border-gray-400"
                    )
                  ]}
                >
                  <span class={
                    if Enum.empty?(@selected_type_vehicule_ids),
                      do: "text-gray-400",
                      else: "text-gray-700"
                  }>
                    <%= if Enum.empty?(@selected_type_vehicule_ids) do %>
                      Sélectionner des véhicules...
                    <% else %>
                      {Enum.count(@selected_type_vehicule_ids)} sélectionné(s)
                    <% end %>
                  </span>
                  <svg
                    class={[
                      "w-4 h-4 text-gray-500 transition-transform duration-200",
                      @show_type_vehicule_dropdown && "rotate-180"
                    ]}
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>

                <%!-- Dropdown panel --%>
                <div
                  :if={@show_type_vehicule_dropdown}
                  class="absolute z-50 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden"
                >
                  <%!-- Search inside dropdown --%>
                  <div class="p-2 border-b border-gray-100">
                    <input
                      type="text"
                      value={@type_vehicule_search}
                      phx-keyup="search_type_vehicule"
                      placeholder="Rechercher un type..."
                      class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>

                  <%!-- Options list --%>
                  <div class="max-h-60 overflow-y-auto py-1">
                    <%= if Enum.empty?(filtered_types_vehicule(@types_vehicule, MapSet.new(), @type_vehicule_search)) do %>
                      <div class="px-3 py-2 text-sm text-gray-400 italic">Aucun résultat</div>
                    <% end %>
                    <label
                      :for={
                        tv <-
                          filtered_types_vehicule(
                            @types_vehicule,
                            MapSet.new(),
                            @type_vehicule_search
                          )
                      }
                      phx-click="toggle_type_vehicule"
                      phx-value-id={tv.id}
                      class={[
                        "flex items-center gap-2 px-3 py-2 text-sm cursor-pointer transition-colors",
                        if(MapSet.member?(@selected_type_vehicule_ids, tv.id),
                          do: "bg-blue-50 text-blue-800",
                          else: "text-gray-700 hover:bg-gray-50"
                        )
                      ]}
                    >
                      <input
                        type="checkbox"
                        checked={MapSet.member?(@selected_type_vehicule_ids, tv.id)}
                        class="w-4 h-4 text-blue-600 border-gray-300 rounded pointer-events-none"
                        readonly
                      />
                      {tv.label}
                    </label>
                  </div>

                  <%!-- Footer --%>
                  <div class="p-2 border-t border-gray-100 bg-gray-50 flex justify-between text-xs text-gray-500">
                    <span>{Enum.count(@selected_type_vehicule_ids)} sélectionné(s)</span>
                    <span>{length(@types_vehicule)} disponible(s)</span>
                  </div>
                </div>
              </div>
            </div>

            <%!-- === Alimentation : Tension (structurée : min/max) + Type (dropdown catalogue) === --%>
            <div class="sm:col-span-2">
              <div class="border-t border-gray-100 pt-6 mt-2">
                <h4 class="text-sm font-semibold text-gray-700 mb-4">Alimentation</h4>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                  <.input
                    field={@form[:voltage_min]}
                    type="number"
                    label="Tension minimale (V)"
                    placeholder="Ex: 9"
                  />
                  <.input
                    field={@form[:voltage_max]}
                    type="number"
                    label="Tension maximale (V)"
                    placeholder="Ex: 36"
                  />
                </div>

                <div class="mb-4">
                  <.input
                    field={@form[:standby_current]}
                    type="number"
                    label="Consommation veille (mA)"
                    placeholder="Ex: 5"
                  />
                </div>

                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Type d'alimentation
                  </label>
                  <div class="relative" phx-click-away="close_power_alim_dropdown">
                    <button
                      type="button"
                      phx-click="toggle_power_alim_dropdown"
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 text-sm border rounded-lg transition-all duration-150 bg-white",
                        if(@show_power_alim_dropdown,
                          do: "border-amber-400 ring-2 ring-amber-200",
                          else: "border-gray-300 hover:border-gray-400"
                        )
                      ]}
                    >
                      <span class={
                        if Enum.empty?(@selected_power_alimentation_ids),
                          do: "text-gray-400",
                          else: "text-gray-700"
                      }>
                        {selected_power_alim_label(
                          @power_alimentations,
                          @selected_power_alimentation_ids
                        )}
                      </span>
                      <svg
                        class={[
                          "w-4 h-4 text-gray-500 transition-transform duration-200",
                          @show_power_alim_dropdown && "rotate-180"
                        ]}
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </button>

                    <div
                      :if={@show_power_alim_dropdown}
                      class="absolute z-50 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden"
                    >
                      <div class="max-h-48 overflow-y-auto py-1">
                        <label
                          phx-click="change_power_alimentation"
                          class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-amber-50 cursor-pointer transition-colors"
                        >
                          <input
                            type="radio"
                            name="type_alimentation"
                            checked={Enum.empty?(@selected_power_alimentation_ids)}
                            class="w-4 h-4 text-amber-600 border-gray-300"
                          /> Aucun
                        </label>
                        <label
                          :for={alim <- @power_alimentations}
                          phx-click="change_power_alimentation"
                          phx-value-id={alim.id}
                          class={[
                            "flex items-center gap-2 px-3 py-2 text-sm cursor-pointer transition-colors",
                            if(MapSet.member?(@selected_power_alimentation_ids, alim.id),
                              do: "bg-amber-50 text-amber-800",
                              else: "text-gray-700 hover:bg-amber-50"
                            )
                          ]}
                        >
                          <input
                            type="radio"
                            name="type_alimentation"
                            checked={MapSet.member?(@selected_power_alimentation_ids, alim.id)}
                            class="w-4 h-4 text-amber-600 border-gray-300"
                            readonly
                          />
                          {alim.label}
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <%!-- === Capteurs : Groupés par catégorie (Checkbox Group) === --%>
            <div class="sm:col-span-2">
              <div class="border-t border-gray-100 pt-6 mt-2">
                <h4 class="text-sm font-semibold text-gray-700 mb-4">Capteurs supportés</h4>

                <div class="space-y-4">
                  <div :for={category <- @capteur_categories}>
                    <%= if category do %>
                      <div class="mb-2">
                        <h5 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">
                          {capteur_category_label(category)}
                        </h5>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                          <label
                            :for={cap <- Enum.filter(@capteurs, &(&1.category == category))}
                            class={[
                              "flex items-center gap-2 px-3 py-2 rounded-lg border cursor-pointer transition-all duration-150",
                              if(MapSet.member?(@selected_capteur_ids, cap.id),
                                do: "bg-sky-50 border-sky-300",
                                else:
                                  "bg-white border-gray-200 hover:border-sky-300 hover:bg-sky-50/50"
                              )
                            ]}
                          >
                            <input
                              type="checkbox"
                              checked={MapSet.member?(@selected_capteur_ids, cap.id)}
                              phx-click="toggle_capteur"
                              phx-value-id={cap.id}
                              class="w-4 h-4 text-sky-600 border-gray-300 rounded"
                            />
                            <span class="text-sm font-medium text-gray-700">{cap.label}</span>
                          </label>
                        </div>
                      </div>
                    <% end %>
                  </div>

                  <%!-- Capteurs sans catégorie --%>
                  <%= if Enum.any?(@capteurs, &is_nil(&1.category)) do %>
                    <div class="mb-2">
                      <h5 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">
                        Autres
                      </h5>
                      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                        <label
                          :for={cap <- Enum.filter(@capteurs, &is_nil(&1.category))}
                          class={[
                            "flex items-center gap-2 px-3 py-2 rounded-lg border cursor-pointer transition-all duration-150",
                            if(MapSet.member?(@selected_capteur_ids, cap.id),
                              do: "bg-sky-50 border-sky-300",
                              else:
                                "bg-white border-gray-200 hover:border-sky-300 hover:bg-sky-50/50"
                            )
                          ]}
                        >
                          <input
                            type="checkbox"
                            checked={MapSet.member?(@selected_capteur_ids, cap.id)}
                            phx-click="toggle_capteur"
                            phx-value-id={cap.id}
                            class="w-4 h-4 text-sky-600 border-gray-300 rounded"
                          />
                          <span class="text-sm font-medium text-gray-700">{cap.label}</span>
                        </label>
                      </div>
                    </div>
                  <% end %>
                </div>

                <%!-- Compteur de sélection --%>
                <div class="mt-3 text-xs text-gray-400">
                  {Enum.count(@selected_capteur_ids)} capteur(s) sélectionné(s)
                </div>
              </div>
            </div>

            <div class="sm:col-span-2">
              <.input
                field={@form[:description]}
                type="textarea"
                label="Description technique"
                rows={4}
              />
            </div>

            <div class="sm:col-span-2 border-t border-gray-100 pt-6 mt-2">
              <h4 class="text-sm font-semibold text-gray-700 mb-4">
                Connectivité et Bus de Données
              </h4>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <label class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer hover:border-blue-300 transition-colors">
                  <input type="hidden" name={@form[:can_bus].name} value="false" />
                  <input
                    type="checkbox"
                    name={@form[:can_bus].name}
                    id={@form[:can_bus].id}
                    value="true"
                    checked={@form[:can_bus].value in [true, "true"]}
                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-800">CAN-Bus</span>
                </label>
                <label class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer hover:border-blue-300 transition-colors">
                  <input type="hidden" name={@form[:one_wire].name} value="false" />
                  <input
                    type="checkbox"
                    name={@form[:one_wire].name}
                    id={@form[:one_wire].id}
                    value="true"
                    checked={@form[:one_wire].value in [true, "true"]}
                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-800">1-Wire</span>
                </label>
                <label class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer hover:border-blue-300 transition-colors">
                  <input type="hidden" name={@form[:rs232].name} value="false" />
                  <input
                    type="checkbox"
                    name={@form[:rs232].name}
                    id={@form[:rs232].id}
                    value="true"
                    checked={@form[:rs232].value in [true, "true"]}
                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-800">RS232</span>
                </label>
                <label class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer hover:border-blue-300 transition-colors">
                  <input type="hidden" name={@form[:rs485].name} value="false" />
                  <input
                    type="checkbox"
                    name={@form[:rs485].name}
                    id={@form[:rs485].id}
                    value="true"
                    checked={@form[:rs485].value in [true, "true"]}
                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-800">RS485</span>
                </label>
              </div>
            </div>

            <div class="sm:col-span-2 border-t border-gray-100 pt-6 mt-2">
              <h4 class="text-sm font-semibold text-gray-700 mb-4">Fonctionnalités</h4>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                <label
                  :for={feat <- @features}
                  class={[
                    "flex items-center gap-2 p-3 rounded-lg border cursor-pointer transition-colors",
                    if(feat.selected,
                      do: "bg-blue-50 border-blue-300",
                      else: "bg-gray-50 border-gray-200 hover:border-blue-300"
                    )
                  ]}
                >
                  <input
                    type="checkbox"
                    name={"features[#{feat.id}]"}
                    id={"feature-#{feat.id}"}
                    value={feat.id}
                    checked={feat.selected}
                    phx-click="toggle_feature"
                    phx-value-id={feat.id}
                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-800">{feat.label}</span>
                </label>
              </div>
            </div>

            <div class="sm:col-span-2 border-t border-gray-100 pt-6 mt-2">
              <h4 class="text-sm font-semibold text-gray-700 mb-4">
                Protection et Environnement
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <.input
                  field={@form[:ip_rating]}
                  type="text"
                  label="Indice de protection IP"
                  placeholder="Ex: IP65, IP67"
                />
              </div>
              <div class="flex flex-wrap gap-4 mt-4">
                <label class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer hover:border-blue-300 transition-colors">
                  <input type="hidden" name={@form[:antennes_externes].name} value="false" />
                  <input
                    type="checkbox"
                    name={@form[:antennes_externes].name}
                    id={@form[:antennes_externes].id}
                    value="true"
                    checked={@form[:antennes_externes].value in [true, "true"]}
                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-800">Antennes externes</span>
                </label>
                <label class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer hover:border-blue-300 transition-colors">
                  <input type="hidden" name={@form[:ultra_low_power].name} value="false" />
                  <input
                    type="checkbox"
                    name={@form[:ultra_low_power].name}
                    id={@form[:ultra_low_power].id}
                    value="true"
                    checked={@form[:ultra_low_power].value in [true, "true"]}
                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-800">Ultra-Low Power</span>
                </label>
                <label class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer hover:border-blue-300 transition-colors">
                  <input type="hidden" name={@form[:accelerometer].name} value="false" />
                  <input
                    type="checkbox"
                    name={@form[:accelerometer].name}
                    id={@form[:accelerometer].id}
                    value="true"
                    checked={@form[:accelerometer].value in [true, "true"]}
                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                  />
                  <span class="text-sm font-medium text-gray-800">Accéléromètre 3 axes</span>
                </label>
              </div>
              <.input
                field={@form[:buffer_memory]}
                type="number"
                label="Mémoire tampon (MB)"
                placeholder="Ex: 256"
              />
            </div>
          </div>
        </div>

        <div class="flex justify-end items-center gap-4">
          <.link
            navigate={~p"/dashboard"}
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-sm font-semibold rounded-xl border-2 border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-gray-400 shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
          >
            Annuler
          </.link>

          <.button
            type="submit"
            variant="primary"
            phx-disable-with="Traitement en cours..."
          >
            {if @modele, do: "Mettre à jour le modèle", else: "Créer le modèle"}
          </.button>
        </div>
      </.form>
    </div>
  </div>
</TagIpWeb.Layouts.app>
