<.header flash={@flash} title={@page_title} current_path={@current_path}>
  <div class="max-w-3xl mx-auto">
    <div class="md:grid md:grid-cols-3 md:gap-6">
      <div class="md:col-span-1">
        <div class="px-4 sm:px-0">
          <h3 class="text-lg font-medium leading-6 text-gray-900">Détails du modèle</h3>
          <p class="mt-1 text-sm text-gray-600">
            Informations détaillées sur le modèle de traceur.
          </p>
        </div>
      </div>

      <div class="mt-5 md:col-span-2 md:mt-0">
        <div class="shadow-sm rounded-md bg-white p-6">
          <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Nom</dt>
              <dd class="mt-1 text-sm text-gray-900">{@modele.nom}</dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Référence</dt>
              <dd class="mt-1 text-sm text-gray-900">{@modele.reference}</dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Types de véhicules compatibles</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= if Enum.empty?(@modele.types_vehicule_compatibles) do %>
                  Aucun type configuré
                <% else %>
                  <div class="flex flex-wrap gap-2">
                    <span
                      :for={type <- @modele.types_vehicule_compatibles}
                      class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"
                    >
                      {type}
                    </span>
                  </div>
                <% end %>
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Alimentations compatibles</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= if Enum.empty?(@modele.alimentations_compatibles) do %>
                  Aucune alimentation configurée
                <% else %>
                  <div class="flex flex-wrap gap-2">
                    <span
                      :for={alim <- @modele.alimentations_compatibles}
                      class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800"
                    >
                      {alim}
                    </span>
                  </div>
                <% end %>
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Capteurs supportés</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= if Enum.empty?(@modele.capteurs_supportes) do %>
                  Aucun capteur supporté
                <% else %>
                  <div class="flex flex-wrap gap-2">
                    <span
                      :for={capteur <- @modele.capteurs_supportes}
                      class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"
                    >
                      {capteur}
                    </span>
                  </div>
                <% end %>
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@modele.description || "Aucune description"}
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Créé le</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {format_datetime(@modele.inserted_at)}
              </dd>
            </div>
          </dl>

          <div class="mt-6 flex space-x-3">
            <.link
              navigate={~p"/modeles/#{@modele.id}/edit"}
              class="bg-blue-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
            >
              Modifier
            </.link>
            <.link
              navigate={~p"/modeles"}
              class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
            >
              Retour
            </.link>
          </div>
        </div>

        <div class="mt-6 shadow-sm rounded-md bg-white p-6">
          <h4 class="text-lg font-medium text-gray-900 mb-4">Profils compatibles</h4>

          <ul class="divide-y divide-gray-200">
            <li :for={compat <- @compatibilites} id={"compat-#{compat.id}"} class="py-4">
              <div class="flex items-center justify-between">
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900">
                    Profil: {compat.profil_montage.nom || compat.profil_montage_id}
                  </p>
                  <p class="text-sm text-gray-500">{compat.details}</p>
                </div>
                <div class="ml-4">
                  <span class={[
                    "px-2 py-1 text-xs font-medium rounded-full",
                    compat.score_compatibilite >= 70 && "bg-green-100 text-green-800",
                    compat.score_compatibilite >= 40 && compat.score_compatibilite < 70 &&
                      "bg-yellow-100 text-yellow-800",
                    compat.score_compatibilite < 40 && "bg-red-100 text-red-800"
                  ]}>
                    {compat.score_compatibilite}%
                  </span>
                </div>
              </div>
            </li>
          </ul>

          <div :if={Enum.empty?(@compatibilites)} class="text-center py-4 text-gray-500">
            Aucune compatibilité calculée pour ce modèle. Utilisez la page d'index des profils pour calculer la compatibilité.
          </div>
        </div>
      </div>
    </div>
  </div>
</.header>
