<TagIpWeb.Layouts.app flash={@flash}>
  <div class="mb-8">
    <.header>
      {@page_title}
      <:subtitle>Détails du modèle de traceur pour TAG-Monitor</:subtitle>
    </.header>
  </div>

  <div class="max-w-3xl mx-auto">
    <div class="md:grid md:grid-cols-3 md:gap-6">
      <div class="md:col-span-1">
        <div class="px-4 sm:px-0">
          <h3 class="text-lg font-medium leading-6 text-gray-900">Détails du modèle</h3>
          <p class="mt-1 text-sm text-gray-600">
            Informations détaillées sur le modèle de traceur.
          </p>
        </div>
      </div>

      <div class="mt-5 md:col-span-2 md:mt-0">
        <div class="shadow-sm rounded-xl bg-white p-6 border border-gray-100">
          <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Nom</dt>
              <dd class="mt-1 text-sm text-gray-900">{@modele.nom}</dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Référence</dt>
              <dd class="mt-1 text-sm text-gray-900">{@modele.reference}</dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Types de véhicules compatibles</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= if Enum.empty?(@modele.types_vehicule_compatibles) do %>
                  <span class="text-gray-400 italic">Aucun type configuré</span>
                <% else %>
                  <div class="flex flex-wrap gap-1.5 mt-1">
                    <span
                      :for={type <- @modele.types_vehicule_compatibles}
                      class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800"
                    >
                      {type}
                    </span>
                  </div>
                <% end %>
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Alimentations compatibles</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= if Enum.empty?(@modele.alimentations_compatibles) do %>
                  <span class="text-gray-400 italic">Aucune alimentation configurée</span>
                <% else %>
                  <div class="flex flex-wrap gap-1.5 mt-1">
                    <span
                      :for={alim <- @modele.alimentations_compatibles}
                      class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800"
                    >
                      {alim}
                    </span>
                  </div>
                <% end %>
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Capteurs supportés</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= if Enum.empty?(@modele.capteurs_supportes) do %>
                  <span class="text-gray-400 italic">Aucun capteur supporté</span>
                <% else %>
                  <div class="flex flex-wrap gap-1.5 mt-1">
                    <span
                      :for={capteur <- @modele.capteurs_supportes}
                      class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800"
                    >
                      {capteur}
                    </span>
                  </div>
                <% end %>
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Interfaces de communication</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <div class="flex flex-wrap gap-1.5 mt-1">
                  <span
                    :if={@modele.can_bus}
                    class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800"
                  >
                    CAN-Bus
                  </span>
                  <span
                    :if={@modele.one_wire}
                    class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800"
                  >
                    1-Wire
                  </span>
                  <span
                    :if={@modele.rs232}
                    class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800"
                  >
                    RS232
                  </span>
                  <span
                    :if={@modele.rs485}
                    class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800"
                  >
                    RS485
                  </span>
                  <span
                    :if={
                      !@modele.can_bus && !@modele.one_wire && !@modele.rs232 && !@modele.rs485
                    }
                    class="text-gray-400 italic"
                  >
                    Aucune interface déclarée
                  </span>
                </div>
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Entrées numériques</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@modele.nb_digital_inputs || "Non déclaré"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Entrées analogiques</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@modele.nb_analog_inputs || "Non déclaré"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Sorties numériques</dt>
              <dd class="mt-1 text-sm text-gray-900">{@modele.nb_outputs || "Non déclaré"}</dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Indice de protection</dt>
              <dd class="mt-1 text-sm text-gray-900">{@modele.ip_rating || "Non spécifié"}</dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Antennes externes</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @modele.antennes_externes, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Ultra-Low Power</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @modele.ultra_low_power, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Accéléromètre 3 axes</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {if @modele.accelerometer, do: "Oui", else: "Non"}
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Mémoire tampon</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@modele.buffer_memory || "Non déclaré"} MB
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Consommation veille</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@modele.standby_current || "Non déclaré"} mA
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {@modele.description || "Aucune description"}
              </dd>
            </div>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Créé le</dt>
              <dd class="mt-1 text-sm text-gray-900">
                {format_datetime(@modele.inserted_at)}
              </dd>
            </div>
          </dl>

          <div class="mt-8 pt-6 border-t border-gray-100 flex space-x-3">
            <.link
              navigate={~p"/modeles/#{@modele.id}/edit"}
              class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-sm font-semibold rounded-xl bg-blue-600 text-white hover:bg-blue-700 shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            >
              Modifier
            </.link>
            <.link
              navigate={~p"/modeles"}
              class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-sm font-semibold rounded-xl border-2 border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-gray-400 shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
            >
              Retour
            </.link>
          </div>
        </div>

        <div class="mt-6 shadow-sm rounded-xl bg-white p-6 border border-gray-100">
          <h4 class="text-lg font-semibold text-gray-900 mb-4">Profils compatibles</h4>

          <ul class="divide-y divide-gray-100">
            <li
              :for={compat <- @compatibilites}
              id={"compat-#{compat.id}"}
              class="py-4 first:pt-0 last:pb-0"
            >
              <div class="flex items-center justify-between">
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900">
                    Profil:
                    <span class="font-semibold">
                      {compat.profil_montage.nom || compat.profil_montage_id}
                    </span>
                  </p>
                  <p class="text-sm text-gray-500 mt-0.5">{compat.details}</p>
                </div>
                <div class="ml-4 shrink-0">
                  <span class={[
                    "inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full",
                    compat.score_compatibilite >= 70 && "bg-green-100 text-green-800",
                    compat.score_compatibilite >= 40 && compat.score_compatibilite < 70 &&
                      "bg-yellow-100 text-yellow-800",
                    compat.score_compatibilite < 40 && "bg-red-100 text-red-800"
                  ]}>
                    {compat.score_compatibilite}%
                  </span>
                </div>
              </div>
            </li>
          </ul>

          <div :if={Enum.empty?(@compatibilites)} class="text-center py-8 text-gray-400 italic">
            Aucune compatibilité calculée pour ce modèle. Utilisez la page d'index des profils pour calculer la compatibilité.
          </div>
        </div>
      </div>
    </div>
  </div>
</TagIpWeb.Layouts.app>
