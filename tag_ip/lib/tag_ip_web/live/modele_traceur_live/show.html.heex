<TagIpWeb.Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mb-8">
    <.header>
      {@page_title}
      <:subtitle>Détails du modèle de traceur pour TAG-Monitor</:subtitle>
    </.header>
  </div>

  <div class="max-w-7xl mx-auto space-y-8">
    <div class="grid gap-6 lg:grid-cols-[1.15fr_1.85fr]">
      <section class="overflow-hidden rounded-[2rem] bg-slate-950 text-white shadow-xl ring-1 ring-slate-200/10">
        <div class="p-8 sm:p-10">
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">
                Modèle
              </p>
              <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white">{@modele.nom}</h1>
              <p class="mt-4 text-sm leading-6 text-slate-300">
                Présentation complète du traceur et de ses compatibilités techniques pour TAG-Monitor.
              </p>
            </div>
            <div class="hidden sm:block rounded-3xl bg-slate-900/80 px-4 py-3 text-sm font-medium text-slate-200">
              {if @modele.reference, do: @modele.reference, else: "Référence inconnue"}
            </div>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-3xl bg-slate-900/80 p-5 ring-1 ring-slate-200/10">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-400">Interfaces</dt>
              <dd class="mt-2 text-lg font-semibold text-white">
                {Enum.count(
                  [@modele.can_bus, @modele.one_wire, @modele.rs232, @modele.rs485]
                  |> Enum.filter(& &1)
                )}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-900/80 p-5 ring-1 ring-slate-200/10">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-400">Créé le</dt>
              <dd class="mt-2 text-base font-medium text-slate-200">
                {format_datetime(@modele.inserted_at)}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-900/80 p-5 ring-1 ring-slate-200/10">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-400">Modifié le</dt>
              <dd class="mt-2 text-base font-medium text-slate-200">
                {format_datetime(@modele.updated_at)}
              </dd>
            </div>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-3xl bg-slate-900/80 p-5 ring-1 ring-slate-200/10">
              <p class="text-sm text-slate-400">Ultra-Low Power</p>
              <p class="mt-3 text-lg font-semibold text-white">
                {if @modele.ultra_low_power, do: "Oui", else: "Non"}
              </p>
            </div>
            <div class="rounded-3xl bg-slate-900/80 p-5 ring-1 ring-slate-200/10">
              <p class="text-sm text-slate-400">Antennes externes</p>
              <p class="mt-3 text-lg font-semibold text-white">
                {if @modele.antennes_externes, do: "Oui", else: "Non"}
              </p>
            </div>
          </div>
        </div>

        <div class="border-t border-white/10 bg-slate-900/80 px-8 py-6">
          <div class="grid gap-3 grid-cols-2">
            <.link
              navigate={~p"/modeles/#{@modele.id}/edit"}
              class="inline-flex items-center justify-center gap-2 rounded-3xl bg-white px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
            >
              <.icon name="hero-pencil-square" class="size-4" /> Modifier
            </.link>
            <.link
              navigate={~p"/modeles/new?duplicate_from=#{@modele.id}"}
              class="inline-flex items-center justify-center gap-2 rounded-3xl border border-teal-300 bg-teal-50 px-5 py-3 text-sm font-semibold text-teal-700 transition hover:bg-teal-100"
            >
              <.icon name="hero-document-duplicate" class="size-4" /> Dupliquer
            </.link>
            <button
              type="button"
              phx-click="confirm_delete"
              phx-value-id={@modele.id}
              class="inline-flex items-center justify-center gap-2 rounded-3xl border border-red-300 bg-red-50 px-5 py-3 text-sm font-semibold text-red-700 transition hover:bg-red-100"
            >
              <.icon name="hero-trash" class="size-4" /> Supprimer
            </button>
            <.link
              navigate={~p"/modeles"}
              class="inline-flex items-center justify-center gap-2 rounded-3xl border border-slate-700 bg-slate-950 px-5 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-900"
            >
              <.icon name="hero-arrow-left" class="size-4" /> Retour
            </.link>
          </div>
        </div>
      </section>

      <div class="space-y-6">
        <section class="overflow-hidden rounded-[2rem] bg-white p-8 shadow-sm ring-1 ring-slate-200/60">
          <div class="flex items-center justify-between gap-6">
            <div>
              <h2 class="text-xl font-semibold text-slate-900">Détails techniques</h2>
              <p class="mt-1 text-sm text-slate-500">Toutes les caractéristiques du modèle.</p>
            </div>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700">
              Fiche technique
            </span>
          </div>

          <dl class="mt-8 grid gap-5 sm:grid-cols-2">
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Marque</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {@modele.brand || "Non spécifiée"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Référence</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {@modele.reference || "Non spécifiée"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">
                Plage de tension
              </dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {if @modele.voltage_min && @modele.voltage_max,
                  do: "#{@modele.voltage_min}V – #{@modele.voltage_max}V",
                  else: "Non spécifiée"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">
                Indice de protection
              </dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {@modele.ip_rating || "Non spécifié"}
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Mémoire tampon</dt>
              <dd class="mt-2 text-sm font-semibold text-slate-900">
                {@modele.buffer_memory || "Non déclaré"} MB
              </dd>
            </div>
          </dl>

          <div class="mt-8 space-y-4">
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">
                Types de véhicules compatibles
              </dt>
              <dd class="mt-3 text-sm leading-6 text-slate-700">
                <%= if Enum.empty?(@modele.types_vehicule) do %>
                  <span class="text-slate-400 italic">Aucun type de véhicule configuré</span>
                <% else %>
                  <div class="flex flex-wrap gap-2">
                    <span
                      :for={tv <- @modele.types_vehicule}
                      class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800"
                    >
                      {tv.label}
                    </span>
                  </div>
                <% end %>
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">
                Alimentations compatibles
              </dt>
              <dd class="mt-3 text-sm leading-6 text-slate-700">
                <%= if @modele.voltage_min && @modele.voltage_max do %>
                  <div class="mb-2">
                    <span class="text-xs text-slate-500">Plage de tension :</span>
                    <div class="mt-1">
                      <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
                        {@modele.voltage_min}V – {@modele.voltage_max}V
                      </span>
                    </div>
                  </div>
                <% end %>
                <%= if Enum.any?(@modele.alimentations, &(&1.category == "power_type")) do %>
                  <div class="mb-1">
                    <span class="text-xs text-slate-500">Modes d'alimentation :</span>
                    <div class="flex flex-wrap gap-2 mt-1">
                      <span
                        :for={
                          alim <-
                            Enum.filter(@modele.alimentations, &(&1.category == "power_type"))
                        }
                        class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800"
                      >
                        {alim.label}
                      </span>
                    </div>
                  </div>
                <% end %>
                <%= if is_nil(@modele.voltage_min) && !Enum.any?(@modele.alimentations, &(&1.category == "power_type")) do %>
                  <span class="text-slate-400 italic">Aucune alimentation configurée</span>
                <% end %>
              </dd>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
              <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">
                Capteurs supportés
              </dt>
              <dd class="mt-3 text-sm leading-6 text-slate-700">
                <%= if Enum.empty?(@modele.capteurs) do %>
                  <span class="text-slate-400 italic">Aucun capteur supporté</span>
                <% else %>
                  <div class="flex flex-wrap gap-2">
                    <span
                      :for={capteur <- @modele.capteurs}
                      class="inline-flex items-center rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-800"
                    >
                      {capteur.label}
                    </span>
                  </div>
                <% end %>
              </dd>
            </div>
          </div>

          <div class="mt-8 rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
            <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">
              Interfaces de communication
            </dt>
            <dd class="mt-4 flex flex-wrap gap-2 text-sm leading-6 text-slate-700">
              <span
                :if={@modele.can_bus}
                class="inline-flex items-center rounded-full bg-purple-100 px-3 py-1 text-xs font-semibold text-purple-800"
              >
                CAN-Bus
              </span>
              <span
                :if={@modele.one_wire}
                class="inline-flex items-center rounded-full bg-purple-100 px-3 py-1 text-xs font-semibold text-purple-800"
              >
                1-Wire
              </span>
              <span
                :if={@modele.rs232}
                class="inline-flex items-center rounded-full bg-purple-100 px-3 py-1 text-xs font-semibold text-purple-800"
              >
                RS232
              </span>
              <span
                :if={@modele.rs485}
                class="inline-flex items-center rounded-full bg-purple-100 px-3 py-1 text-xs font-semibold text-purple-800"
              >
                RS485
              </span>
              <span
                :if={!@modele.can_bus && !@modele.one_wire && !@modele.rs232 && !@modele.rs485}
                class="text-slate-400 italic"
              >
                Aucune interface déclarée
              </span>
            </dd>
          </div>

          <div class="mt-8 rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
            <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">
              Fonctionnalités
            </dt>
            <dd class="mt-4 flex flex-wrap gap-2 text-sm leading-6 text-slate-700">
              <span
                :for={feat <- @modele.features}
                class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800"
              >
                {feat.label}
              </span>
              <span
                :if={Enum.empty?(@modele.features)}
                class="text-slate-400 italic"
              >
                Aucune fonctionnalité déclarée
              </span>
            </dd>
          </div>

          <div class="mt-8 rounded-3xl bg-slate-50 p-5 ring-1 ring-slate-200/60">
            <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">
              Ports matériels
            </dt>
            <dd class="mt-4 space-y-2 text-sm leading-6 text-slate-700">
              <div
                :for={port <- @model_ports}
                class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-2"
              >
                <span class="font-mono text-xs font-semibold text-slate-900">
                  {port.pin_label}
                </span>
                <span class="inline-flex items-center rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-medium text-indigo-700">
                  {port.port_type.label}
                </span>
              </div>
              <div
                :if={Enum.empty?(@model_ports)}
                class="text-slate-400 italic"
              >
                Aucun port déclaré
              </div>
            </dd>
          </div>
        </section>

        <section class="overflow-hidden rounded-[2rem] bg-white p-8 shadow-sm ring-1 ring-slate-200/60">
          <div class="flex items-center justify-between gap-6">
            <div>
              <h2 class="text-xl font-semibold text-slate-900">Profils compatibles</h2>
              <p class="mt-1 text-sm text-slate-500">
                Liste des profils ayant une compatibilité calculée avec ce modèle.
              </p>
            </div>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700">
              {Enum.count(@compatibilites)} résultats
            </span>
          </div>

          <div class="mt-6 space-y-4">
            <div
              :if={Enum.empty?(@compatibilites)}
              class="rounded-3xl border border-dashed border-slate-200 bg-slate-50 p-8 text-center text-sm text-slate-500"
            >
              Aucune compatibilité calculée pour ce modèle. Utilisez la page d'index des profils pour calculer la compatibilité.
            </div>

            <ul class="space-y-4">
              <li
                :for={compat <- @compatibilites}
                id={"compat-#{compat.id}"}
                class="rounded-3xl border border-slate-200 p-5 shadow-sm"
              >
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <p class="text-sm text-slate-500">Profil compatible</p>
                    <p class="mt-1 text-base font-semibold text-slate-900">
                      {compat.profil_montage.name || compat.profil_montage_id}
                    </p>
                    <p class="mt-2 text-sm leading-6 text-slate-600">{compat.details}</p>
                  </div>
                  <span class={[
                    "inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold",
                    compat.score_compatibilite >= 70 && "bg-emerald-100 text-emerald-800",
                    compat.score_compatibilite >= 40 && compat.score_compatibilite < 70 &&
                      "bg-amber-100 text-amber-800",
                    compat.score_compatibilite < 40 && "bg-rose-100 text-rose-800"
                  ]}>
                    {compat.score_compatibilite}%
                  </span>
                </div>
              </li>
            </ul>
          </div>
        </section>
      </div>
    </div>
  </div>

  <.confirm_modal show={@pending_delete_id != nil}>
    Êtes-vous sûr de vouloir supprimer <strong>{@pending_delete_label}</strong> ?
    Cette action est irréversible.
  </.confirm_modal>
</TagIpWeb.Layouts.app>
