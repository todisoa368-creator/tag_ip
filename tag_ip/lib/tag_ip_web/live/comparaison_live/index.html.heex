<TagIpWeb.Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-7xl mx-auto my-10">
    <div class="bg-white border border-gray-200 shadow-sm rounded-2xl p-8">
      <div class="mb-2">
        <h1 class="text-2xl font-bold text-gray-900">
          Assistant de comparaison — Prérequis techniques
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          {Enum.at(@steps, @step - 1)[:description]}
        </p>
      </div>

      <%!-- Progress Steps --%>
      <div class="relative mb-10 mt-8">
        <div class="flex items-center justify-between">
          <div :for={s <- @steps} class="flex items-center flex-1 last:flex-none">
            <div class="flex flex-col items-center">
              <button
                type="button"
                phx-click="go_to_step"
                phx-value-step={s.num}
                class={[
                  "w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold border-2 transition-all duration-300 cursor-pointer",
                  s.num < @step && "bg-blue-600 border-blue-600 text-white",
                  s.num == @step && "bg-white border-blue-600 text-blue-600 shadow-md",
                  s.num > @step && "bg-gray-100 border-gray-300 text-gray-400"
                ]}
              >
                <.icon :if={s.num < @step} name="hero-check" class="w-5 h-5 text-white" />
                <span :if={s.num >= @step}>{s.num}</span>
              </button>
              <span class={[
                "text-xs mt-2 font-medium transition-colors duration-300 text-center",
                s.num <= @step && "text-blue-700",
                s.num > @step && "text-gray-400"
              ]}>
                {s.title}
              </span>
            </div>
            <div
              :if={s.num < @total_steps}
              class={[
                "flex-1 h-1 mx-4 rounded transition-all duration-500",
                s.num < @step && "bg-blue-600",
                s.num >= @step && "bg-gray-200"
              ]}
            />
          </div>
        </div>
      </div>

      <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden mb-8">
        <div
          class="bg-linear-to-r from-blue-500 to-blue-600 h-full rounded-full transition-all duration-500 ease-out shadow-sm"
          style="width: {(@step / @total_steps) * 100}%"
        />
      </div>

      <%!-- ============================== STEP 1: TYPE DE TRACEUR ============================== --%>
      <div :if={@step == 1}>
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm font-bold">
              1
            </div>
            <div>
              <h2 class="text-lg font-semibold text-gray-900">Type de traceur</h2>
              <p class="text-sm text-gray-500">Sélectionnez la marque et le type de véhicule</p>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <%!-- Marque --%>
            <div class="bg-white rounded-xl border border-gray-200 p-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-3">Marque</h3>
              <div class="flex items-center gap-2">
                <.icon name="hero-building-office" class="w-5 h-5 text-gray-500" />
                <select
                  name="brand"
                  phx-change="brand_changed"
                  class="w-full rounded-md border-gray-200 px-2 py-1.5 text-sm shadow-sm hover:shadow-md"
                >
                  <option value="">Fournisseur</option>
                  <option
                    :for={b <- @brands}
                    value={b}
                    selected={MapSet.member?(@selected_brands, b)}
                  >
                    {supplier_label(b)}
                  </option>
                </select>
              </div>
            </div>

            <%!-- Type de véhicule --%>
            <div class="bg-white rounded-xl border border-gray-200 p-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-3">Type de véhicule</h3>
              <div class="flex items-center gap-2">
                <.icon name="hero-truck" class="w-5 h-5 text-gray-500" />
                <select
                  name="type"
                  phx-change="type_changed"
                  class="w-full rounded-md border-gray-200 px-2 py-1.5 text-sm shadow-sm hover:shadow-md"
                >
                  <option value="">Type</option>
                  <option
                    :for={tv <- @types_vehicule}
                    value={tv.id}
                    selected={MapSet.member?(@selected_type_vehicule_ids, tv.id)}
                  >
                    {tv.label}
                  </option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%!-- ============================== STEP 2: FONCTIONNALITÉS ============================== --%>
      <div :if={@step == 2}>
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm font-bold">
              2
            </div>
            <div>
              <h2 class="text-lg font-semibold text-gray-900">Fonctionnalités souhaitées</h2>
              <p class="text-sm text-gray-500">
                Sélectionnez les fonctionnalités dont le client a besoin
              </p>
            </div>
          </div>

          <p class="text-sm text-gray-600 mb-4">
            <strong>{MapSet.size(@selected_feature_slugs)}</strong>
            fonctionnalité(s) sélectionnée(s)
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <label
              :for={feat <- @features}
              class={[
                "flex items-start gap-3 p-4 bg-white rounded-xl border-2 cursor-pointer transition-all duration-200",
                MapSet.member?(@selected_feature_slugs, feat.slug) &&
                  "border-blue-500 bg-blue-50 shadow-sm",
                !MapSet.member?(@selected_feature_slugs, feat.slug) &&
                  "border-gray-200 hover:border-blue-300 hover:shadow-sm"
              ]}
            >
              <div class="shrink-0 mt-0.5">
                <div class={[
                  "w-5 h-5 rounded-md border-2 flex items-center justify-center transition-all",
                  MapSet.member?(@selected_feature_slugs, feat.slug) &&
                    "bg-blue-600 border-blue-600",
                  !MapSet.member?(@selected_feature_slugs, feat.slug) &&
                    "bg-white border-gray-300"
                ]}>
                  <.icon
                    :if={MapSet.member?(@selected_feature_slugs, feat.slug)}
                    name="hero-check"
                    class="w-3.5 h-3.5 text-white"
                  />
                </div>
              </div>
              <div class="flex-1 min-w-0" phx-click="toggle_feature" phx-value-slug={feat.slug}>
                <span class="text-sm font-medium text-gray-900 block">
                  {feature_label(feat.slug)}
                </span>
                <span class="text-xs text-gray-500">{feat.description}</span>
              </div>
            </label>
          </div>
        </div>
      </div>

      <%!-- ============================== STEP 3: ÉQUIPEMENTS ============================== --%>
      <div :if={@step == 3}>
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm font-bold">
              3
            </div>
            <div>
              <h2 class="text-lg font-semibold text-gray-900">Équipements</h2>
              <p class="text-sm text-gray-500">Alimentation, capteurs et périphériques</p>
            </div>
          </div>

          <div class="space-y-6">
            <%!-- Alimentation --%>
            <div class="bg-white rounded-xl border border-gray-200 p-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-3">
                Alimentation <span class="text-xs text-gray-400 font-normal ml-1">optionnel</span>
              </h3>
              <div class="flex items-center gap-2">
                <.icon name="hero-bolt" class="w-5 h-5 text-amber-500" />
                <select
                  name="alimentation"
                  phx-change="alimentation_changed"
                  class="w-full rounded-md border-gray-200 px-2 py-1.5 text-sm shadow-sm hover:shadow-md"
                >
                  <option value="">Alimentation</option>
                  <option
                    :for={a <- @alimentations}
                    value={a.id}
                    selected={MapSet.member?(@selected_alimentation_ids, a.id)}
                  >
                    {a.label}
                  </option>
                </select>
              </div>
            </div>

            <%!-- Capteurs --%>
            <div class="bg-white rounded-xl border border-gray-200 p-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-3">
                Capteurs <span class="text-xs text-gray-400 font-normal ml-1">optionnel</span>
              </h3>
              <div class="flex items-center gap-2">
                <.icon name="hero-sparkles" class="w-5 h-5 text-purple-500" />
                <select
                  name="capteur"
                  phx-change="capteur_changed"
                  class="w-full rounded-md border-gray-200 px-2 py-1.5 text-sm shadow-sm hover:shadow-md"
                >
                  <option value="">Capteur</option>
                  <option
                    :for={c <- @capteurs}
                    value={c.id}
                    selected={MapSet.member?(@selected_capteur_ids, c.id)}
                  >
                    {c.label}
                  </option>
                </select>
              </div>
            </div>

            <%!-- Périphériques --%>
            <div class="bg-white rounded-xl border border-gray-200 p-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-3">
                Périphériques
                <span class="text-xs text-gray-400 font-normal ml-1">optionnel</span>
              </h3>
              <div class="flex items-center gap-2">
                <.icon name="hero-chip" class="w-5 h-5 text-green-500" />
                <select
                  name="peripheral"
                  phx-change="peripheral_changed"
                  class="w-full rounded-md border-gray-200 px-2 py-1.5 text-sm shadow-sm hover:shadow-md"
                >
                  <option value="">Périphérique</option>
                  <option
                    :for={p <- @peripherals}
                    value={p.id}
                    selected={MapSet.member?(@selected_peripheral_ids, p.id)}
                  >
                    {p.name}
                  </option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%!-- ============================== STEP 4: RÉSULTATS ============================== --%>
      <div :if={@step == 4}>
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm font-bold">
              4
            </div>
            <div>
              <h2 class="text-lg font-semibold text-gray-900">Résultats</h2>
              <p class="text-sm text-gray-500">Modèles compatibles avec vos critères</p>
            </div>
          </div>

          <%!-- Résumé des critères --%>
          <div class="bg-white rounded-xl border border-gray-200 p-4 mb-4">
            <h3 class="text-xs font-semibold text-gray-700 uppercase tracking-wide mb-3">
              Critères appliqués
            </h3>
            <div class="flex flex-wrap gap-2">
              <span
                :for={brand <- MapSet.to_list(@selected_brands)}
                class="inline-flex items-center gap-1 px-2.5 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-medium"
              >
                Marque : {supplier_label(brand)}
              </span>
              <span
                :for={tv_id <- MapSet.to_list(@selected_type_vehicule_ids)}
                class="inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-100 text-indigo-800 rounded-full text-xs font-medium"
              >
                {Enum.find(@types_vehicule, &(&1.id == tv_id)).label}
              </span>
              <span
                :for={slug <- MapSet.to_list(@selected_feature_slugs)}
                class="inline-flex items-center gap-1 px-2.5 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-medium"
              >
                {feature_label(slug)}
              </span>
              <span
                :for={aid <- MapSet.to_list(@selected_alimentation_ids)}
                class="inline-flex items-center gap-1 px-2.5 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-medium"
              >
                {Enum.find(@alimentations, &(&1.id == aid)).label}
              </span>
              <span
                :for={cid <- MapSet.to_list(@selected_capteur_ids)}
                class="inline-flex items-center gap-1 px-2.5 py-1 bg-purple-100 text-purple-800 rounded-full text-xs font-medium"
              >
                {Enum.find(@capteurs, &(&1.id == cid)).label}
              </span>
              <span
                :for={pid <- MapSet.to_list(@selected_peripheral_ids)}
                class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-medium"
              >
                {Enum.find(@peripherals, &(&1.id == pid)).name}
              </span>
              <span
                :if={
                  Enum.empty?(MapSet.to_list(@selected_brands)) &&
                    Enum.empty?(MapSet.to_list(@selected_feature_slugs)) &&
                    Enum.empty?(MapSet.to_list(@selected_peripheral_ids)) &&
                    Enum.empty?(MapSet.to_list(@selected_alimentation_ids)) &&
                    Enum.empty?(MapSet.to_list(@selected_capteur_ids)) &&
                    Enum.empty?(MapSet.to_list(@selected_type_vehicule_ids))
                }
                class="text-sm text-gray-400 italic"
              >
                Aucun critère — tous les modèles affichés
              </span>
            </div>
          </div>

          <div class="flex items-center gap-2 mb-4">
            <.icon name="hero-cpu-chip" class="size-5 text-indigo-600" />
            <span class="text-sm font-medium text-gray-700">
              {@total_count} modèle(s) compatible(s)
            </span>
            <button
              phx-click="toggle_sort"
              type="button"
              class="ml-4 inline-flex items-center gap-2 px-2 py-1 text-sm font-medium bg-white border border-gray-200 rounded-md hover:bg-gray-50"
            >
              Trier par score
              <.icon
                name={if @sort_desc, do: "hero-chevron-down", else: "hero-chevron-up"}
                class="w-4 h-4 text-gray-600"
              />
            </button>
            <button
              phx-click="compare_selected"
              type="button"
              class={"ml-3 inline-flex items-center gap-2 px-3 py-1 text-sm font-medium rounded-md " <> (if MapSet.size(@selected_model_ids) < 2, do: "bg-gray-100 text-gray-400 pointer-events-none", else: "bg-blue-600 text-white hover:bg-blue-700")}
            >
              Comparer sélectionnés
              <span class="text-xs bg-white/10 px-2 py-0.5 rounded">
                {MapSet.size(@selected_model_ids)}
              </span>
            </button>
            <button
              phx-click="clear_selection"
              type="button"
              class="ml-2 inline-flex items-center gap-2 px-2 py-1 text-sm font-medium bg-white border border-gray-200 rounded-md hover:bg-gray-50"
            >
              Effacer
            </button>
          </div>

          <%!-- Aucun résultat --%>
          <div
            :if={Enum.empty?(@compatible_modeles)}
            class="p-12 text-center bg-white rounded-xl border border-gray-200"
          >
            <.icon name="hero-magnifying-glass" class="size-12 text-gray-300 mx-auto mb-4" />
            <h3 class="text-lg font-medium text-gray-500">Aucun modèle compatible</h3>
            <p class="text-sm text-gray-400 mt-1">
              Aucun traceur ne supporte l'ensemble des critères sélectionnés.
            </p>
          </div>

          <%!-- Tableau des résultats --%>
          <div
            :if={!Enum.empty?(@compatible_modeles)}
            class="overflow-x-auto bg-white rounded-xl border border-gray-200"
          >
            <table class="min-w-full divide-y divide-gray-200 text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap sticky left-0 bg-gray-50 z-10">
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap sticky left-0 bg-gray-50 z-10">
                    Marque
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap">
                    Modèle
                  </th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap">
                    Score
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap">
                    Tension
                  </th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap">
                    IP
                  </th>
                  <th class="px-2 py-3 text-center text-xs font-semibold uppercase tracking-wider whitespace-nowrap min-w-[60px] bg-amber-50/50 text-amber-800">
                    CAN
                  </th>
                  <th class="px-2 py-3 text-center text-xs font-semibold uppercase tracking-wider whitespace-nowrap min-w-[60px] bg-blue-50/50 text-blue-800">
                    1W
                  </th>
                  <th class="px-2 py-3 text-center text-xs font-semibold uppercase tracking-wider whitespace-nowrap min-w-[60px] bg-cyan-50/50 text-cyan-800">
                    232
                  </th>
                  <th class="px-2 py-3 text-center text-xs font-semibold uppercase tracking-wider whitespace-nowrap min-w-[60px] bg-emerald-50/50 text-emerald-800">
                    485
                  </th>
                  <th class="px-2 py-3 text-center text-xs font-semibold uppercase tracking-wider whitespace-nowrap min-w-[60px] bg-violet-50/50 text-violet-800">
                    BLE
                  </th>
                  <th
                    :for={feat <- @features}
                    class="px-2 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap min-w-[80px]"
                  >
                    {feature_label(feat.slug)}
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <tr
                  :for={modele <- @compatible_modeles}
                  class="hover:bg-blue-50/50 transition-colors"
                >
                  <td class="px-3 py-3 whitespace-nowrap text-gray-700 sticky left-0 bg-white hover:bg-blue-50/50 z-10">
                    <input
                      type="checkbox"
                      phx-click="toggle_select_model"
                      phx-value-id={modele.id}
                      checked={MapSet.member?(@selected_model_ids, modele.id)}
                      class="w-4 h-4"
                    />
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-gray-700 sticky left-0 bg-white hover:bg-blue-50/50 z-10">
                    {supplier_label(modele.brand)}
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap font-medium text-gray-900">
                    {modele.nom}
                    <span class="text-gray-400 font-mono text-xs ml-1">({modele.reference})</span>
                  </td>
                  <td class="px-4 py-3 text-center whitespace-nowrap">
                    <% score = Map.get(@scores || %{}, modele.id) %>
                    <span class={
                      "inline-flex items-center gap-2 px-2 py-1 rounded-full text-xs font-semibold" <> 
                        (if score >= 80, do: " bg-emerald-100 text-emerald-700", else: if(score >= 50, do: " bg-amber-100 text-amber-700", else: " bg-red-50 text-red-600"))
                    }>
                      {score}%
                    </span>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-gray-600">
                    {if modele.voltage_min, do: "#{modele.voltage_min}V", else: "-"}–{if modele.voltage_max,
                      do: "#{modele.voltage_max}V",
                      else: "-"}
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-center text-gray-600">
                    {modele.ip_rating || "-"}
                  </td>
                  <td class="px-2 py-3 text-center">
                    <span class={[
                      "inline-flex items-center justify-center w-7 h-7 rounded-lg transition-all",
                      modele.can_bus && "bg-amber-100 shadow-sm",
                      !modele.can_bus && "bg-gray-50"
                    ]}>
                      <.icon
                        name={if modele.can_bus, do: "hero-check", else: "hero-x-mark"}
                        class={
                          if modele.can_bus,
                            do: "size-4 text-amber-600",
                            else: "size-4 text-gray-300"
                        }
                      />
                    </span>
                  </td>
                  <td class="px-2 py-3 text-center">
                    <span class={[
                      "inline-flex items-center justify-center w-7 h-7 rounded-lg transition-all",
                      modele.one_wire && "bg-blue-100 shadow-sm",
                      !modele.one_wire && "bg-gray-50"
                    ]}>
                      <.icon
                        name={if modele.one_wire, do: "hero-check", else: "hero-x-mark"}
                        class={
                          if modele.one_wire,
                            do: "size-4 text-blue-600",
                            else: "size-4 text-gray-300"
                        }
                      />
                    </span>
                  </td>
                  <td class="px-2 py-3 text-center">
                    <span class={[
                      "inline-flex items-center justify-center w-7 h-7 rounded-lg transition-all",
                      modele.rs232 && "bg-cyan-100 shadow-sm",
                      !modele.rs232 && "bg-gray-50"
                    ]}>
                      <.icon
                        name={if modele.rs232, do: "hero-check", else: "hero-x-mark"}
                        class={
                          if modele.rs232,
                            do: "size-4 text-cyan-600",
                            else: "size-4 text-gray-300"
                        }
                      />
                    </span>
                  </td>
                  <td class="px-2 py-3 text-center">
                    <span class={[
                      "inline-flex items-center justify-center w-7 h-7 rounded-lg transition-all",
                      modele.rs485 && "bg-emerald-100 shadow-sm",
                      !modele.rs485 && "bg-gray-50"
                    ]}>
                      <.icon
                        name={if modele.rs485, do: "hero-check", else: "hero-x-mark"}
                        class={
                          if modele.rs485,
                            do: "size-4 text-emerald-600",
                            else: "size-4 text-gray-300"
                        }
                      />
                    </span>
                  </td>
                  <td class="px-2 py-3 text-center">
                    <span class={[
                      "inline-flex items-center justify-center w-7 h-7 rounded-lg transition-all",
                      modele.bluetooth_ble && "bg-violet-100 shadow-sm",
                      !modele.bluetooth_ble && "bg-gray-50"
                    ]}>
                      <.icon
                        name={if modele.bluetooth_ble, do: "hero-check", else: "hero-x-mark"}
                        class={
                          if modele.bluetooth_ble,
                            do: "size-4 text-violet-600",
                            else: "size-4 text-gray-300"
                        }
                      />
                    </span>
                  </td>
                  <td :for={feat <- @features} class="px-2 py-3 text-center">
                    <span
                      :if={feature_supported?(modele, feat.slug)}
                      class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100"
                    >
                      <.icon name="hero-check" class="size-3.5 text-emerald-600" />
                    </span>
                    <span
                      :if={!feature_supported?(modele, feat.slug)}
                      class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-50"
                    >
                      <.icon name="hero-x-mark" class="size-3.5 text-red-400" />
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <%!-- Cartes comparaison côte-à-côte --%>
          <div :if={@show_cards} class="mt-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Comparaison visuelle</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <div
                :for={
                  m <-
                    Enum.filter(@compatible_modeles, &MapSet.member?(@selected_model_ids, &1.id))
                }
                class="bg-white rounded-xl border border-gray-200 p-4"
              >
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h4 class="text-lg font-semibold text-gray-900">{m.nom}</h4>
                    <div class="text-xs text-gray-500">
                      {supplier_label(m.brand)} • {m.reference}
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-sm font-bold">{Map.get(@scores || %{}, m.id)}%</div>
                    <div class="text-xs text-gray-400">score</div>
                  </div>
                </div>

                <div class="mt-3 text-sm text-gray-700">
                  <div>
                    <strong>Tension:</strong> {if m.voltage_min,
                      do: "#{m.voltage_min}V",
                      else: "-"}–{if m.voltage_max, do: "#{m.voltage_max}V", else: "-"}
                  </div>
                  <div class="mt-1"><strong>IP:</strong> {m.ip_rating || "-"}</div>

                  <div class="mt-2">
                    <div class="text-sm font-medium text-gray-700">Interfaces</div>
                    <div class="flex flex-wrap gap-1.5 mt-1.5">
                      <span
                        :if={m.can_bus}
                        class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700 ring-1 ring-amber-200/60"
                      >
                        <.icon name="hero-cpu-chip" class="size-3" /> CAN
                      </span>
                      <span
                        :if={m.one_wire}
                        class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-0.5 text-[11px] font-semibold text-blue-700 ring-1 ring-blue-200/60"
                      >
                        <.icon name="hero-link" class="size-3" /> 1W
                      </span>
                      <span
                        :if={m.rs232}
                        class="inline-flex items-center gap-1 rounded-full bg-cyan-50 px-2 py-0.5 text-[11px] font-semibold text-cyan-700 ring-1 ring-cyan-200/60"
                      >
                        <.icon name="hero-arrow-right-end-on-rectangle" class="size-3" /> 232
                      </span>
                      <span
                        :if={m.rs485}
                        class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 ring-1 ring-emerald-200/60"
                      >
                        <.icon name="hero-arrow-path" class="size-3" /> 485
                      </span>
                      <span
                        :if={m.bluetooth_ble}
                        class="inline-flex items-center gap-1 rounded-full bg-violet-50 px-2 py-0.5 text-[11px] font-semibold text-violet-700 ring-1 ring-violet-200/60"
                      >
                        <.icon name="hero-wifi" class="size-3" /> BLE
                      </span>
                      <span
                        :if={
                          !m.can_bus && !m.one_wire && !m.rs232 && !m.rs485 && !m.bluetooth_ble
                        }
                        class="text-xs text-gray-400 italic"
                      >
                        Aucune
                      </span>
                    </div>
                  </div>

                  <div class="mt-3">
                    <div class="text-sm font-medium text-gray-700">Fonctionnalités</div>
                    <div class="flex flex-wrap gap-2 mt-2">
                      <span
                        :for={f <- @features}
                        class={[
                          "text-xs px-2 py-1 rounded-full",
                          feature_supported?(m, f.slug) && "bg-emerald-100 text-emerald-700",
                          !feature_supported?(m, f.slug) && "bg-red-50 text-red-400"
                        ]}
                      >
                        {feature_label(f.slug)}
                      </span>
                    </div>
                  </div>
                </div>

                <div class="mt-4 flex gap-2">
                  <button
                    phx-click="clear_selection"
                    class="text-sm px-3 py-2 bg-gray-100 rounded"
                  >
                    Fermer comparaison
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%!-- ============================== BOUTONS ============================== --%>
      <div class="flex items-center justify-between pt-6 border-t border-gray-200">
        <div>
          <button
            :if={@step > 1}
            type="button"
            phx-click="prev_step"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:border-gray-400 transition-all shadow-sm"
          >
            <.icon name="hero-chevron-left" class="w-4 h-4" /> Précédent
          </button>
        </div>

        <div class="flex items-center gap-4">
          <.link
            navigate={~p"/dashboard"}
            class="text-sm font-medium text-gray-400 hover:text-gray-600 transition-colors"
          >
            Ignorer
          </.link>

          <button
            :if={@step < @total_steps}
            type="button"
            phx-click="next_step"
            class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm hover:shadow-md transition-all"
          >
            Suivant <.icon name="hero-chevron-right" class="w-4 h-4" />
          </button>

          <div :if={@step == @total_steps && !@saved} class="flex items-center gap-3">
            <button
              type="button"
              phx-click="save"
              class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-white bg-emerald-600 rounded-lg hover:bg-emerald-700 shadow-sm hover:shadow-md transition-all"
            >
              <.icon name="hero-check" class="w-4 h-4" /> Valider et enregistrer
            </button>
          </div>

          <div :if={@step == @total_steps && @saved} class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg">
              <.icon name="hero-check-circle" class="w-5 h-5" /> Enregistré
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</TagIpWeb.Layouts.app>
