<TagIpWeb.Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Organisations</h1>
    <.link
      navigate={~p"/organisations/new"}
      class="inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-xl bg-blue-600 text-white hover:bg-blue-700 shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
    >
      + Nouvelle organisation
    </.link>
  </div>

  <%= if Enum.empty?(@organisations) do %>
    <div class="bg-white border-2 border-dashed border-gray-300 rounded-xl p-14 text-center">
      <.icon name="hero-building-office-2" class="size-12 text-gray-300 mx-auto mb-4" />
      <p class="text-gray-500 text-lg font-medium">Aucune organisation trouvée.</p>
      <p class="text-gray-400 text-sm mb-6">Commencez par en ajouter une.</p>
      <.link
        navigate={~p"/organisations/new"}
        class="inline-flex items-center gap-1.5 text-blue-600 font-semibold hover:text-blue-700 transition-colors"
      >
        <.icon name="hero-plus-circle" class="size-5" /> Créer votre première organisation
      </.link>
    </div>
  <% else %>
    <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
              Nom
            </th>
            <th class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
              Slug
            </th>
            <th class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
              Description
            </th>
            <th class="px-6 py-3.5 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <tr
            :for={org <- @organisations}
            id={"organisation-#{org.id}"}
            class="hover:bg-gray-50/80 transition-colors duration-150"
          >
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="text-sm font-semibold text-gray-900">{org.name}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="text-xs text-gray-500 font-mono">{org.slug}</span>
            </td>
            <td class="px-6 py-4">
              <span class="text-sm text-gray-500">{org.description || "—"}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right">
              <div class="flex items-center justify-end gap-1">
                <.link
                  navigate={~p"/organisations/#{org}/edit"}
                  class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium rounded-lg border border-indigo-200 text-indigo-700 hover:bg-indigo-50 hover:border-indigo-300 transition-all duration-150"
                >
                  <.icon name="hero-pencil-square" class="size-3.5" />
                </.link>
                <button
                  phx-click="confirm_delete"
                  phx-value-id={org.id}
                  class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium rounded-lg border border-red-200 text-red-700 hover:bg-red-50 hover:border-red-300 transition-all duration-150"
                >
                  <.icon name="hero-trash" class="size-3.5" />
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>

  <.confirm_modal show={@pending_delete_id != nil}>
    Êtes-vous sûr de vouloir supprimer <strong>{@pending_delete_label}</strong>
    ? Cette action est irréversible.
  </.confirm_modal>
</TagIpWeb.Layouts.app>
